<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp"
                android:layout_margin="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvRegTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crear Cuenta"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvRegSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paso 1 de 3: Identidad"
                    android:textColor="#94a3b8"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="16dp"
                    tools:ignore="HardcodedText" />

                <ProgressBar
                    android:id="@+id/pbRegister"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:progress="33"
                    android:progressTint="#7c3aed" />

                <TextView
                    android:id="@+id/tvRegisterError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="#f87171"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <!-- PASO 1: IDENTIDAD -->
                <LinearLayout
                    android:id="@+id/layoutStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cédula"
                            android:textColor="#94a3b8"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/tvProvincia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textColor="#10b981"
                            android:textSize="12sp"
                            android:textStyle="bold|italic"
                            android:visibility="gone"
                            tools:text="Provincia: Tungurahua"
                            tools:visibility="visible" />
                    </RelativeLayout>

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegCedula" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegCedula" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="10 dígitos" android:maxLength="10" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" android:inputType="number" tools:ignore="TextFields" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegNombre" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="Tu nombre" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" tools:ignore="TextFields" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apellido" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegApellido" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegApellido" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="Tu apellido" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" tools:ignore="TextFields" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- PASO 2: CONTACTO -->
                <LinearLayout
                    android:id="@+id/layoutStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Correo Electrónico" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegEmail" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="ejemplo@correo.com" android:inputType="textEmailAddress" android:maxLength="35" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Teléfono" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegPhone" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="0991234567" android:inputType="phone" android:maxLength="10" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ciudad" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegCity" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="Ciudad de residencia" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" tools:ignore="TextFields" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- PASO 3: SEGURIDAD -->
                <LinearLayout
                    android:id="@+id/layoutStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contraseña" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="#FFFFFF" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegPassword" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="••••••••" android:inputType="textPassword" android:maxLength="16" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirmar Contraseña" android:textColor="#94a3b8" android:layout_marginBottom="4dp" tools:ignore="HardcodedText" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRegConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="#FFFFFF" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRegConfirmPassword" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:hint="••••••••" android:inputType="textPassword" android:maxLength="16" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#8094a3b8" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#7c3aed"
                    android:text="Siguiente"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    tools:ignore="HardcodedText" />

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#10b981"
                    android:text="Crear Cuenta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvBackStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="8dp"
                    android:text="Volver"
                    android:textAlignment="center"
                    android:textColor="#94a3b8"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:text="¿Ya tienes cuenta? Inicia sesión"
                    android:textAlignment="center"
                    android:textColor="#7c3aed"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
