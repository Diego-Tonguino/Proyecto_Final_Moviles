<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome">

    <!-- Header Flotante Premium (unificado con HomeActivity) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llProfileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#4D000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#4DFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuración"
                    android:textColor="#94a3b8"
                    android:textSize="14sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Perfil"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botón de Cerrar Sesión igual al de Home -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutProfile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Salir"
                android:textAllCaps="false"
                android:textColor="#f87171"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconSize="18dp"
                app:iconTint="#f87171"
                app:strokeColor="#40F87171"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llProfileHeader"
        app:layout_constraintBottom_toTopOf="@id/cardBottomNav"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Avatar Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:id="@+id/flAvatarContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerHorizontal="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:src="@android:drawable/ic_menu_camera"
                        app:strokeWidth="3dp"
                        app:strokeColor="#A855F7"
                        android:background="#16162A"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        app:cardCornerRadius="18dp"
                        app:cardBackgroundColor="#A855F7"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#FFFFFF"/>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/flAvatarContainer"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:text="Editar Perfil"
                    android:textColor="#94a3b8"
                    android:textSize="14sp" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/pbProfile"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:indeterminateTint="#A855F7" />

            <!-- Cédula -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÉDULA" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfCedula" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_menu_info_details" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfCedula" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:inputType="number" android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nombre -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NOMBRE" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_menu_myplaces" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfNombre" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Apellido -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="APELLIDO" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfApellido" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_menu_myplaces" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfApellido" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CORREO ELECTRÓNICO" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_dialog_email" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfEmail" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Teléfono -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TELÉFONO" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_menu_call" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfPhone" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:inputType="phone" android:maxLength="10" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ciudad -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CIUDAD" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_dialog_map" app:startIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfCity" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Header Seguridad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_secure"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seguridad"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Nueva Contraseña -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUEVA CONTRASEÑA (OPCIONAL)" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_lock_lock" app:startIconTint="#A1A1AA" app:endIconMode="password_toggle" app:endIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:hint="Dejar vacío para mantener" android:inputType="textPassword" android:maxLength="16" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#80A1A1AA" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmar Contraseña -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONFIRMAR CONTRASEÑA" android:textColor="#A855F7" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilProfConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:hintEnabled="false" app:startIconDrawable="@android:drawable/ic_lock_lock" app:startIconTint="#A1A1AA" app:endIconMode="password_toggle" app:endIconTint="#A1A1AA" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etProfConfirmPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_input" android:hint="Confirmar contraseña" android:inputType="textPassword" android:maxLength="16" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textColorHint="#80A1A1AA" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primary Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#A855F7"
                android:text="Guardar Cambios"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="30dp" />

            <!-- Botón Log de Errores -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewErrorLog"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="🪲  Ver Log de Errores"
                android:textColor="#a78bfa"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#44a78bfa"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Menú de Navegación Flotante (unificado) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#4D000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#4DFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:itemPaddingTop="12dp"
            app:itemPaddingBottom="12dp"
            app:menu="@menu/bottom_nav_menu" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
