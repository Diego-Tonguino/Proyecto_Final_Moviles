---
// src/pages/perfil.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Mi Perfil | NorthWind">
    <div class="profile-container">
        <header class="page-header">
            <h1>Mi Perfil</h1>
            <p>Gestiona tu información personal y foto de perfil</p>
        </header>

        <div class="profile-content">
            <div class="profile-card picture-section">
                <div class="avatar-wrapper">
                    <img id="profile-img" src="" alt="Foto de perfil" style="display: none;" />
                    <svg id="profile-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <div id="avatar-loading" class="avatar-overlay" style="display: none;">
                        <svg class="spinner" viewBox="0 0 50 50">
                            <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                        </svg>
                    </div>
                </div>
                
                <h3>Foto de Perfil</h3>
                <p class="text-muted">JPG, PNG. Max 5MB.</p>
                
                <div class="picture-actions" style="display: flex; flex-direction: column; gap: 0.75rem; width: 100%;">
                    <input type="file" id="file-upload" accept="image/jpeg, image/png, image/webp" style="display: none;" />
                    
                    <button class="btn-perfil-purple-large" onclick="document.getElementById('file-upload').click()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M12 10l0 4"></path><path d="M10 12l4 0"></path></svg>
                        Cambiar Foto
                    </button>
                    
                    <button class="btn-perfil-red-outline-large" id="btn-delete-pic" style="display: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path d="M14 11l0 6"></path><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path></svg>
                        Eliminar foto
                    </button>
                </div>
            </div>

            <div class="profile-card info-section">
                <h3>Información de la Cuenta</h3>
                <div class="info-grid">
                    <div class="info-group">
                        <label>Nombre</label>
                        <p id="info-firstname">Cargando...</p>
                    </div>
                    <div class="info-group">
                        <label>Apellido</label>
                        <p id="info-lastname">Cargando...</p>
                    </div>
                    <div class="info-group">
                        <label>Correo Electrónico</label>
                        <p id="info-email">Cargando...</p>
                    </div>
                    <div class="info-group">
                        <label>Rol asignado</label>
                        <p id="info-role">
                            <span class="badge" id="badge-role">Cargando...</span>
                        </p>
                    </div>
                    <div class="info-group full-width">
                        <label>ID de Usuario</label>
                        <p id="info-id" class="code-text">Cargando...</p>
                    </div>
                </div>

                <button class="btn btn-edit-profile" id="btn-edit-profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Editar Perfil
                </button>
            </div>
        </div>
    </div>

    <div id="editProfileModal" class="modal-overlay" style="display: none;">
        <div class="registro-card">
            <button class="btn-close-registro" id="btnCloseEditModal">&times;</button>
            
            <div class="registro-header">
                <h2>Editar Perfil</h2>
                <p>Actualiza tu información personal</p>
            </div>
            
            <div class="registro-body">
                <form id="editProfileForm">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label for="editFirstName">Nombre</label>
                            <input type="text" id="editFirstName" class="reg-input" maxlength="15" placeholder="Tu nombre" autocomplete="off" />
                        </div>
                        <div class="form-group">
                            <label for="editLastName">Apellido</label>
                            <input type="text" id="editLastName" class="reg-input" maxlength="15" placeholder="Tus apellidos" autocomplete="off" />
                        </div>
                    </div>
                    
                    <div class="form-group" style="margin-bottom: 1rem;">
                        <label for="editEmail">Correo electrónico</label>
                        <input type="email" id="editEmail" class="reg-input" maxlength="50" placeholder="ejemplo@empresa.com" autocomplete="off" style="color: #93c5fd; font-weight: bold;" />
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                        <div class="form-group">
                            <label for="editPassword">Nueva contraseña</label>
                            <div class="password-wrapper">
                                <input type="password" id="editPassword" class="reg-input" placeholder="••••••••" autocomplete="new-password" />
                                <button type="button" class="btn-eye" onclick="togglePassword('editPassword')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="editConfirmPassword">Confirmar contraseña</label>
                            <div class="password-wrapper">
                                <input type="password" id="editConfirmPassword" class="reg-input" placeholder="••••••••" autocomplete="new-password" />
                                <button type="button" class="btn-eye" onclick="togglePassword('editConfirmPassword')">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div id="editAlert" class="alert" style="display: none;"></div>
                    
                    <button type="submit" class="btn-registro-submit" id="btnGuardarForm">
                        <span id="btnSaveText">Guardar Cambios</span>
                        <div id="btnSaveSpinner" class="spinner-small" style="display:none; margin: 0 auto;"></div>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="deleteConfirmModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
            <div class="modal-icon-container" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="modal-icon-svg" style="color: #ef4444;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <h2 class="modal-title">¿Eliminar Foto?</h2>
            <p class="modal-text">
                Estás a punto de eliminar tu foto de perfil de forma permanente. Esta acción no se puede deshacer.
            </p>
            <div class="modal-actions">
                <button class="btn-modal btn-cancel" id="btnCancelDeletePic">Cancelar</button>
                <button class="btn-modal btn-confirm" id="btnConfirmDeletePic" style="background: #ef4444;">
                    <span id="btnDeleteText">Sí, eliminar</span>
                    <div id="btnDeleteSpinner" class="spinner-small" style="display:none;"></div>
                </button>
            </div>
        </div>
    </div>

    <div id="toastNotif" class="toast-notif" style="display: none;"><span id="toastMsg">Operación exitosa</span></div>

</MainLayout>

<style>
    :root {
        --primary: #7c3aed;
        --primary-hover: #6d28d9;
        --bg-registro: #1f163f; 
        --bg-input-reg: #160f2e;
        --color-primary: #7c3aed; 
        --color-primary-hover: #6d28d9;
    }

    .profile-container { max-width: 1000px; margin: 0 auto; padding: 1rem; }
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 2rem; font-weight: 700; color: white; margin-bottom: 0.5rem; }
    .page-header p { color: var(--text-muted, #94a3b8); font-size: 1rem; }

    .profile-content { display: grid; grid-template-columns: 1fr; gap: 2rem; }
    @media (min-width: 768px) { .profile-content { grid-template-columns: 1fr 2fr; } }

    .profile-card { background: var(--card-bg, rgba(30, 20, 60, 0.6)); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 1rem; padding: 2rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3); }
    .profile-card h3 { font-size: 1.25rem; color: white; margin-bottom: 1.5rem; font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.75rem; }

    /* Picture Section */
    .picture-section { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .avatar-wrapper { width: 160px; height: 160px; border-radius: 50%; background: rgba(124, 58, 237, 0.1); border: 4px solid rgba(124, 58, 237, 0.3); margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; box-shadow: 0 10px 25px rgba(124, 58, 237, 0.2); }
    .avatar-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-wrapper svg { width: 64px; height: 64px; color: var(--primary, #8b5cf6); }
    .avatar-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; border-radius: 50%; }

    .text-muted { color: var(--text-muted, #94a3b8); font-size: 0.875rem; margin-bottom: 1.5rem; }
    .picture-actions { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
    
    /* Botones de Foto Perfil Verticales */
    .btn-perfil-purple-large { width: 100%; padding: 12px 20px; display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--color-primary); color: white; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3); }
    .btn-perfil-purple-large:hover { background: var(--color-primary-hover); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4); }
    .btn-perfil-purple-large svg { width: 16px; height: 16px; }

    .btn-perfil-red-outline-large { width: 100%; padding: 12px 20px; display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(239, 68, 68, 0.1); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-perfil-red-outline-large:hover { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.4); color: white; transform: translateY(-1px); }
    .btn-perfil-red-outline-large svg { width: 16px; height: 16px; }

    .spinner-small { width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { 100% { transform: rotate(360deg); } }

    /* Info Section */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .info-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .info-group.full-width { grid-column: 1 / -1; }
    .info-group label { font-size: 0.875rem; font-weight: 500; color: var(--text-muted, #94a3b8); }
    .info-group p { font-size: 1rem; color: white; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.05); padding: 0.75rem 1rem; border-radius: 0.5rem; user-select: none; pointer-events: none; }
    .code-text { font-family: monospace; letter-spacing: 0.5px; color: #a78bfa !important; }
    .badge { font-size: 0.8rem; font-weight: 700; padding: 4px 12px; border-radius: 12px; letter-spacing: 0.5px; text-transform: uppercase; display: inline-block; }
    .role-admin { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.3); }
    .role-seller { background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.3); }

    .spinner { animation: rotate 2s linear infinite; width: 40px; height: 40px; }
    .spinner .path { stroke: white; stroke-linecap: round; animation: dash 1.5s ease-in-out infinite; }
    @keyframes rotate { 100% { transform: rotate(360deg); } }
    @keyframes dash { 0% { stroke-dasharray: 1, 150; stroke-dashoffset: 0; } 50% { stroke-dasharray: 90, 150; stroke-dashoffset: -35; } 100% { stroke-dasharray: 90, 150; stroke-dashoffset: -124; } }

    /* =========================================
       NUEVOS ESTILOS DEL MODAL DE EDICIÓN
       ========================================= */
    .registro-card { background: var(--bg-registro); border-radius: 1.25rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); width: 90%; max-width: 500px; padding: 2.5rem; position: relative; animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .btn-close-registro { position: absolute; top: 1rem; right: 1.5rem; background: transparent; border: none; color: #a59fc4; font-size: 2rem; cursor: pointer; transition: color 0.2s; padding: 0; line-height: 1; }
    .btn-close-registro:hover { color: white; }
    
    .registro-header { text-align: center; margin-bottom: 2rem; }
    .registro-header h2 { color: white; font-size: 1.8rem; font-weight: 700; margin: 0 0 0.5rem 0; letter-spacing: -0.025em; }
    .registro-header p { color: #a59fc4; font-size: 0.95rem; margin: 0; }
    
    .form-group label { display: block; color: #a59fc4; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; }
    
    .reg-input { width: 100%; padding: 12px 16px; border-radius: 0.5rem; background: var(--bg-input-reg); border: 1px solid #36295e; color: white; font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s; }
    .reg-input::placeholder { color: #5a4b86; }
    .reg-input:focus { border-color: var(--color-primary); }
    
    .password-wrapper { position: relative; display: flex; align-items: center; }
    .password-wrapper input { padding-right: 40px; }
    .btn-eye { position: absolute; right: 10px; background: transparent; border: none; color: #a59fc4; cursor: pointer; padding: 4px; display: flex; }
    .btn-eye:hover { color: white; }
    .btn-eye svg { width: 18px; height: 18px; }
    
    .btn-registro-submit { width: 100%; background: var(--color-primary); color: white; border: none; padding: 14px; border-radius: 0.5rem; font-size: 1.05rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-top: 0.5rem; display: flex; justify-content: center; align-items: center; gap: 10px; }
    .btn-registro-submit:hover { background: var(--color-primary-hover); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4); }
    .btn-registro-submit:active { transform: translateY(0); }
    
    .btn-edit-profile { margin-top: 2rem; background: rgba(124, 58, 237, 0.1); color: #a78bfa; border: 1px solid rgba(124, 58, 237, 0.3); }
    .btn-edit-profile:hover { background: rgba(124, 58, 237, 0.2); color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2); }
    
    .alert { padding: 12px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 1rem; text-align: left; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #fca5a5; }

    /* =========================================
       MODAL ELIMINAR FOTO (DISEÑO SÓLIDO EXACTO)
       ========================================= */
    .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 2000; animation: fadeIn 0.2s ease-out; }
    
    .modal-card { width: 90%; max-width: 420px; background: #1f163f; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 1.25rem; padding: 2.5rem 2rem; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8); animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    
    .modal-icon-container { width: 64px; height: 64px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; }
    .modal-icon-svg { width: 32px; height: 32px; color: #ef4444; }
    
    .modal-title { color: white; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.75rem; margin-top: 0; }
    .modal-text { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem; }
    
    .modal-actions { display: flex; gap: 1rem; justify-content: center; }
    .btn-modal { flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    
    .btn-cancel { background: #2a204d; color: white; border: 1px solid rgba(255, 255, 255, 0.1); }
    .btn-cancel:hover { background: #36295e; border-color: rgba(255, 255, 255, 0.2); }
    
    .btn-confirm { background: #ef4444; color: white; border: none; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3); }
    .btn-confirm:hover { background: #dc2626; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4); }
    .btn-confirm:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
    
    /* TOAST ESTILO VERDE */
    .toast-notif { position: fixed; bottom: 30px; right: 30px; color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 3000; animation: slideInUp 0.3s ease; }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes scaleUp { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    @keyframes slideInUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>

<script is:inline>
window.togglePassword = function(fieldId) {
    const field = document.getElementById(fieldId);
    if (field) {
        field.type = field.type === 'password' ? 'text' : 'password';
    }
};
</script>

<script>
document.addEventListener('DOMContentLoaded', async () => {
    const token = localStorage.getItem('northwind_token');
    let userId = localStorage.getItem('northwind_user_id');
    const userRole = localStorage.getItem('northwind_user_role') || 'Vendedor';

    function parseJwt(token: string) {
        try {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        } catch (e) { return null; }
    }

    if (!token) { window.location.href = '/login'; return; }

    if (!userId) {
        const decoded = parseJwt(token);
        if (decoded) {
            userId = decoded.sub || decoded.nameid || decoded['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier'] || decoded.uid || decoded.id || '';
            if (userId) localStorage.setItem('northwind_user_id', userId);
        }
    }

    if (!userId) { window.location.href = '/login'; return; }

    const infoFirstName = document.getElementById('info-firstname');
    const infoLastName = document.getElementById('info-lastname');
    const infoEmail = document.getElementById('info-email');
    const infoId = document.getElementById('info-id');
    const badgeRole = document.getElementById('badge-role');
    const profileImg = document.getElementById('profile-img') as HTMLImageElement;
    const profileSvg = document.getElementById('profile-svg');
    const avatarLoading = document.getElementById('avatar-loading');
    
    // Función centralizada para el Toast
    function showToast(message: string, isError = false) {
        const toast = document.getElementById('toastNotif');
        const toastMsg = document.getElementById('toastMsg');
        if (toast && toastMsg) {
            toastMsg.textContent = message;
            toast.style.background = isError ? '#ef4444' : '#10b981';
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }
    }

    // CHECKEAR MENSAJES PENDIENTES TRAS RECARGA
    if (sessionStorage.getItem('profile_photo_updated') === 'true') {
        showToast("Foto actualizada exitosamente");
        sessionStorage.removeItem('profile_photo_updated');
    }
    if (sessionStorage.getItem('profile_photo_deleted') === 'true') {
        showToast("Foto eliminada exitosamente");
        sessionStorage.removeItem('profile_photo_deleted');
    }
    if (sessionStorage.getItem('profile_updated') === 'true') {
        showToast("Perfil actualizado con éxito");
        sessionStorage.removeItem('profile_updated');
    }

    const fileUpload = document.getElementById('file-upload') as HTMLInputElement;
    const btnDeletePic = document.getElementById('btn-delete-pic');
    const editModal = document.getElementById('editProfileModal');
    const btnEditProfile = document.getElementById('btn-edit-profile');
    const btnCloseEditModal = document.getElementById('btnCloseEditModal');
    const editForm = document.getElementById('editProfileForm') as HTMLFormElement;
    const editAlert = document.getElementById('editAlert');
    
    const editFirstName = document.getElementById('editFirstName') as HTMLInputElement;
    const editLastName = document.getElementById('editLastName') as HTMLInputElement;
    const editEmail = document.getElementById('editEmail') as HTMLInputElement;
    const editPassword = document.getElementById('editPassword') as HTMLInputElement;
    const editConfirmPassword = document.getElementById('editConfirmPassword') as HTMLInputElement;

    const API_BASE = 'http://localhost:5033/api/users';
    const avatarUrlBase = `${API_BASE}/${userId}/profile-picture`;

    let currentUserData: any = null;

    function formatName(value: string) {
        if (!value) return "";
        return value.charAt(0).toUpperCase() + value.slice(1).toLowerCase();
    }

    const preventSpaces = (e: KeyboardEvent) => { if (e.key === " ") e.preventDefault(); };
    const preventNonLetters = (e: KeyboardEvent) => { 
        if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ]+$/.test(e.key) && e.key !== "Backspace" && e.key !== "Tab" && e.key !== "Enter") {
            e.preventDefault();
        }
    };

    [editFirstName, editLastName, editEmail, editPassword, editConfirmPassword].forEach(input => {
        input?.addEventListener('keydown', preventSpaces);
    });

    [editFirstName, editLastName].forEach(input => {
        input?.addEventListener('keydown', preventNonLetters);
        input?.addEventListener('blur', (e: any) => {
            e.target.value = formatName(e.target.value.trim());
        });
    });

    async function loadUserData() {
        try {
            const res = await fetch(`${API_BASE}/${userId}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            if (res.ok) {
                const data = await res.json();
                currentUserData = data;
                
                if(infoFirstName) infoFirstName.textContent = data.firstName || data.FirstName || "---";
                if(infoLastName) infoLastName.textContent = data.lastName || data.LastName || "---";
                if(infoEmail) infoEmail.textContent = data.email || data.Email || "---";
                if(infoId) infoId.textContent = userId;
                
                const esAdmin = (data.roles?.[0] || userRole).toLowerCase().includes('admin');
                if(badgeRole) {
                    badgeRole.textContent = esAdmin ? "ADMINISTRADOR" : "VENDEDOR";
                    badgeRole.className = "badge " + (esAdmin ? "role-admin" : "role-seller");
                }
                
                localStorage.setItem('northwind_user_name', `${data.firstName} ${data.lastName}`.trim());
                localStorage.setItem('northwind_user_email', data.email);
            }
        } catch (err) { console.error("Error cargando perfil", err); }
    }

    function checkAndLoadProfilePicture() {
        if(avatarLoading) avatarLoading.style.display = 'flex';
        fetch(avatarUrlBase, { headers: { 'Authorization': `Bearer ${token}` } })
        .then(response => {
            if(avatarLoading) avatarLoading.style.display = 'none';
            if (response.ok) {
                if(profileImg) {
                    profileImg.src = avatarUrlBase + "?t=" + new Date().getTime();
                    profileImg.style.display = 'block';
                }
                if(profileSvg) profileSvg.style.display = 'none';
                if(btnDeletePic) btnDeletePic.style.display = 'flex'; 
            } else {
                if(profileImg) profileImg.style.display = 'none';
                if(profileSvg) profileSvg.style.display = 'block';
                if(btnDeletePic) btnDeletePic.style.display = 'none';
            }
        }).catch(() => { if(avatarLoading) avatarLoading.style.display = 'none'; });
    }

    if(btnEditProfile) {
        btnEditProfile.onclick = () => {
            if (!currentUserData) return;
            editFirstName.value = currentUserData.firstName || currentUserData.FirstName || "";
            editLastName.value = currentUserData.lastName || currentUserData.LastName || "";
            editEmail.value = currentUserData.email || currentUserData.Email || "";
            editPassword.value = "";
            editConfirmPassword.value = "";
            
            editPassword.type = 'password';
            editConfirmPassword.type = 'password';
            
            if(editAlert) editAlert.style.display = 'none';
            if(editModal) editModal.style.display = 'flex';
        };
    }

    const closeModal = () => { if(editModal) editModal.style.display = 'none'; };
    if(btnCloseEditModal) btnCloseEditModal.onclick = closeModal;

    if(editForm) {
        editForm.onsubmit = async (e) => {
            e.preventDefault();
            if(editAlert) editAlert.style.display = 'none';
            
            const fName = editFirstName.value.trim();
            const lName = editLastName.value.trim();
            const mail = editEmail.value.trim();
            const pass = editPassword.value;
            const confPass = editConfirmPassword.value;

            if (!fName || !lName || !mail) {
                if(editAlert) { editAlert.textContent = "Nombre, apellido y correo son obligatorios."; editAlert.style.display = 'block'; }
                return;
            }

            if ((pass || confPass) && pass !== confPass) {
                if(editAlert) { editAlert.textContent = "Las contraseñas no coinciden."; editAlert.style.display = 'block'; }
                return;
            }

            const btnSaveText = document.getElementById('btnSaveText');
            const btnSaveSpinner = document.getElementById('btnSaveSpinner');
            if(btnSaveText) btnSaveText.style.display = 'none';
            if(btnSaveSpinner) btnSaveSpinner.style.display = 'block';

            try {
                const body: any = {
                    id: userId,
                    firstName: fName,
                    lastName: lName,
                    email: mail,
                    userName: mail,
                    roles: currentUserData.roles || currentUserData.Roles
                };
                if (pass) body.password = pass;

                const res = await fetch(`${API_BASE}/${userId}`, {
                    method: 'PUT',
                    headers: { 
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(body)
                });

                if (res.ok) {
                    sessionStorage.setItem('profile_updated', 'true');
                    window.location.reload();
                } else {
                    const err = await res.json();
                    if(editAlert) { editAlert.textContent = err.message || "Error al actualizar el perfil (¿Email ya en uso?)"; editAlert.style.display = 'block'; }
                }
            } catch (err) {
                if(editAlert) { editAlert.textContent = "Error de conexión al servidor."; editAlert.style.display = 'block'; }
            } finally {
                if(btnSaveText) btnSaveText.style.display = 'block';
                if(btnSaveSpinner) btnSaveSpinner.style.display = 'none';
            }
        };
    }

    // Subir imagen (Sin Modal, directo y recarga)
    if(fileUpload) {
        fileUpload.onchange = async (e: any) => {
            const file = e.target.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                showToast("Máximo 5MB permitido", true);
                return;
            }
            
            const formData = new FormData();
            formData.append('image', file);
            if(avatarLoading) avatarLoading.style.display = 'flex';
            
            try {
                const res = await fetch(avatarUrlBase, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });
                if (res.ok) {
                    sessionStorage.setItem('profile_photo_updated', 'true');
                    window.location.reload();
                } else { 
                    showToast("Error al actualizar la foto", true); 
                    if(avatarLoading) avatarLoading.style.display = 'none'; 
                }
            } catch { 
                showToast("Error de conexión", true); 
                if(avatarLoading) avatarLoading.style.display = 'none'; 
            } finally { 
                fileUpload.value = ""; 
            }
        };
    }

    // Modal de confirmación SÓLO para eliminar
    const deleteModal = document.getElementById('deleteConfirmModal');
    const btnCancelDeletePic = document.getElementById('btnCancelDeletePic');
    const btnConfirmDeletePic = document.getElementById('btnConfirmDeletePic') as HTMLButtonElement;
    const btnDeleteText = document.getElementById('btnDeleteText');
    const btnDeleteSpinner = document.getElementById('btnDeleteSpinner');

    if(btnDeletePic) btnDeletePic.onclick = () => { if(deleteModal) deleteModal.style.display = 'flex'; };
    if(btnCancelDeletePic) btnCancelDeletePic.onclick = () => { if(deleteModal) deleteModal.style.display = 'none'; };
    
    if(btnConfirmDeletePic) {
        btnConfirmDeletePic.onclick = async () => {
            btnConfirmDeletePic.disabled = true;
            if(btnDeleteText) btnDeleteText.style.display = 'none';
            if(btnDeleteSpinner) btnDeleteSpinner.style.display = 'block';
            
            try {
                const res = await fetch(avatarUrlBase, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    sessionStorage.setItem('profile_photo_deleted', 'true');
                    window.location.reload();
                } else {
                    showToast("Error al eliminar", true);
                    btnConfirmDeletePic.disabled = false;
                    if(btnDeleteText) btnDeleteText.style.display = 'block';
                    if(btnDeleteSpinner) btnDeleteSpinner.style.display = 'none';
                    if(deleteModal) deleteModal.style.display = 'none';
                }
            } catch { 
                showToast("Error de conexión", true); 
                btnConfirmDeletePic.disabled = false;
                if(btnDeleteText) btnDeleteText.style.display = 'block';
                if(btnDeleteSpinner) btnDeleteSpinner.style.display = 'none';
                if(deleteModal) deleteModal.style.display = 'none';
            }
        };
    }

    await loadUserData();
    checkAndLoadProfilePicture();
});
</script>