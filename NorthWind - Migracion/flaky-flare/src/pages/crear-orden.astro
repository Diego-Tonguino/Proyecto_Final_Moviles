---
// src/pages/crear-orden.astro
import MainLayout from '../layouts/MainLayout.astro';
import ClienteModal from '../components/ClienteModal.astro';
import ProductoModal from '../components/ProductoModal.astro'; 

const iconSearch = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
const iconSave = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>';
---

<MainLayout title="Crear Orden - NorthWind">
    
    <div class="page-content">
        <div class="page-header-top no-print">
            <h1 class="page-header-title">
                Nueva Orden N°: <span id="displayInvoiceNumber" style="color: #a78bfa;">...</span>
            </h1>
        </div>

        <div class="dashboard-grid no-print">
            <div class="column-left">
                <div class="glass-panel mb-4">
                    <h2 class="panel-title">Clientes</h2>
                    <div class="button-group">
                        <button class="btn-glass" type="button" id="btnBuscarCliente">
                            <span set:html={iconSearch}></span> Seleccionar Cliente
                        </button>
                    </div>
                </div>

                <div class="glass-panel panel-fill">
                    <h3 class="panel-subtitle" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; margin-bottom: 0.8rem;">Información de Facturación</h3>
                    
                    <div class="form-grid">
                        <!-- ID Interno oculto para la base de datos -->
                        <input type="hidden" id="internalCustomerId">
                        
                        <div class="input-wrapper">
                            <label>Cédula Cliente</label>
                            <input type="text" id="customerCedula" placeholder="Cédula..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Nombre</label>
                            <input type="text" id="firstName" placeholder="Nombre..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Apellido</label>
                            <input type="text" id="lastName" placeholder="Apellido..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Correo Electrónico</label>
                            <input type="text" id="email" placeholder="Correo..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Teléfono</label>
                            <input type="text" id="phone" placeholder="Teléfono..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Ciudad</label>
                            <input type="text" id="shipCity" placeholder="Ciudad..." readonly class="readonly-field">
                        </div>
                        <div class="input-wrapper">
                            <label>Dirección de Facturación <span style="color: #a78bfa; font-weight: normal; font-size: 0.75rem;"></span></label>
                            <input type="text" id="shipAddress" placeholder="Ingrese la dirección detallada...">
                        </div>
                        <div class="input-wrapper">
                            <label>Código Postal <span style="color: #a78bfa; font-weight: normal; font-size: 0.75rem;"></span></label>
                            <input type="text" id="shipPostalCode" placeholder="Ej. 17015" maxlength="5">
                        </div>
                    </div>
                </div>
            </div>

            <div class="column-right">
                <div class="glass-panel mb-4">
                    <h2 class="panel-title">Productos</h2>
                    <div class="button-group">
                        <button class="btn-glass" type="button" id="btnBuscarProducto">
                            <span set:html={iconSearch}></span> Seleccionar Productos
                        </button>
                    </div>
                </div>

                <div class="glass-panel panel-fill">
                    <h3 class="panel-subtitle" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; margin-bottom: 0.8rem;">Productos agregados a la orden</h3>
                    <div class="table-container" id="contenedorTablaOrden">
                        <table class="dark-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%;">ID</th>
                                    <th style="width: 25%;">Nombre</th>
                                    <th style="width: 25%;">Descripción</th>
                                    <th style="text-align: right; width: 12%;">Precio</th>
                                    <th style="text-align: right; width: 10%;">Cant.</th>
                                    <th style="text-align: right; width: 12%;">Subtotal</th>
                                    <th style="text-align: center; width: 8%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="listaProductosCuerpo">
                                <tr id="filaVacia">
                                    <td colspan="7" class="text-center text-empty" style="padding: 6rem 1rem; white-space: normal;">
                                        No hay productos en la orden
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="full-width-footer">
                <div class="glass-panel totales-panel">
                    <div class="totales-info">
                        <div class="total-row"><span>Sub total:</span><span id="txtSubtotal">$0.00</span></div>
                        <div class="total-row"><span>IVA (15%):</span><span id="txtIva">$0.00</span></div>
                        <div class="total-row grand-total"><span>Total:</span><span id="txtTotal">$0.00</span></div>
                    </div>
                    <div class="totales-action">
                        <button class="btn-primary btn-large" type="button" id="btnGuardarOrden">
                            <span id="btnGuardarText" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem;"><span set:html={iconSave}></span> Guardar Orden y Facturar</span>
                            <div id="btnSpinner" class="spinner-small" style="display:none; margin: 0 auto;"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="invoicePrintArea" class="print-only">
        <div class="invoice-header">
            <div class="invoice-logo">
                <h2>NORTHWIND TRADERS</h2>
                <p>Tu socio de negocios global</p>
            </div>
            <div class="invoice-details">
                <h1 style="color: #333; margin-bottom: 5px;">FACTURA</h1>
                <p><strong>N° Factura:</strong> <span id="printInvoiceNumber"></span></p>
                <p><strong>Fecha:</strong> <span id="printDate"></span></p>
                <p><strong>Estado:</strong> Pagado / Completado</p>
            </div>
        </div>

        <div class="invoice-billing">
            <div>
                <h3>Facturar a:</h3>
                <!-- Ahora mostramos la cédula en la factura -->
                <p><strong id="printFullName"></strong> (CI: <span id="printCustomerCedula"></span>)</p>
                <p><strong>Email:</strong> <span id="printEmail"></span></p>
                <p><strong>Teléfono:</strong> <span id="printPhone"></span></p>
                <p><strong>Ciudad:</strong> <span id="printCity"></span></p>
                <p><strong>Dirección:</strong> <span id="printAddress"></span></p>
                <p><strong>C.P.:</strong> <span id="printPostalCode"></span></p>
            </div>
            <div style="text-align: right;">
                <h3>Emitido por:</h3>
                <p><strong id="printIssuerName">Usuario del Sistema</strong></p>
                <p id="printIssuerEmail"></p>
            </div>
        </div>

        <table class="invoice-table">
            <thead>
                <tr>
                    <th style="text-align: left;">ID</th>
                    <th style="text-align: left;">Descripción del Producto</th>
                    <th style="text-align: center;">Cant.</th>
                    <th style="text-align: right;">Precio Unit.</th>
                    <th style="text-align: right;">Subtotal</th>
                </tr>
            </thead>
            <tbody id="printTableBody">
                </tbody>
        </table>

        <div class="invoice-totals">
            <div class="totals-row">
                <span>Subtotal:</span>
                <span id="printSubtotal">$0.00</span>
            </div>
            <div class="totals-row">
                <span id="printIvaLabel">IVA (15%):</span>
                <span id="printIva">$0.00</span>
            </div>
            <div class="totals-row totals-grand">
                <span>TOTAL A PAGAR:</span>
                <span id="printTotal">$0.00</span>
            </div>
        </div>

        <div class="invoice-footer">
            <p>¡Gracias por su compra!</p>
        </div>
    </div>

    <!-- MODAL: ABANDONAR ORDEN -->
    <div id="leaveConfirmModal" class="modal-overlay" style="display: none; z-index: 3000;">
        <div class="modal-card" style="background: #1a103c; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1.25rem; padding: 2.5rem 2rem; width: 90%; max-width: 420px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);">
            
            <div style="margin-bottom: 1rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 48px; height: 48px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>

            <h2 style="color: white; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.75rem; margin-top: 0;">¿Abandonar la orden?</h2>
            
            <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
                Tienes datos de una orden en curso. Si cambias de página ahora, <strong style="color: white;">se borrará todo lo que has hecho</strong> y no podrás recuperarlo.
            </p>
            
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <button id="btnConfirmLeave" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #ef4444; color: white; border: none; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Salir y borrar
                </button>
                <button id="btnCancelLeave" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #2a204d; color: white; border: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.2s;" onmouseover="this.style.background='#36295e'" onmouseout="this.style.background='#2a204d'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    No, quedarme
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: ELIMINAR PRODUCTO -->
    <div id="deleteProductConfirmModal" class="modal-overlay" style="display: none; z-index: 3000;">
        <div class="modal-card" style="background: #1a103c; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1.25rem; padding: 2.5rem 2rem; width: 90%; max-width: 420px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);">
            <div style="margin-bottom: 1rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 48px; height: 48px;">
                    <polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
            </div>
            <h2 style="color: white; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.75rem; margin-top: 0;">¿Eliminar producto?</h2>
            <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
                ¿Estás seguro que deseas quitar <strong style="color: white;" id="deleteProductNameDisplay">este producto</strong> de la orden?
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <button id="btnConfirmDeleteProduct" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #ef4444; color: white; border: none; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
                    Sí, eliminar
                </button>
                <button id="btnCancelDeleteProduct" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #2a204d; color: white; border: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.2s;" onmouseover="this.style.background='#36295e'" onmouseout="this.style.background='#2a204d'">
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL: CAMBIAR CLIENTE -->
    <div id="changeClientConfirmModal" class="modal-overlay" style="display: none; z-index: 3000;">
        <div class="modal-card" style="background: #1a103c; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1.25rem; padding: 2.5rem 2rem; width: 90%; max-width: 420px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);">
            <div style="margin-bottom: 1rem;">
                <!-- Icono cambiado a rojo (#ef4444) -->
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 48px; height: 48px;">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line>
                </svg>
            </div>
            <h2 style="color: white; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.75rem; margin-top: 0;">¿Cambiar de cliente?</h2>
            <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
                Ya tienes un cliente seleccionado para esta orden. ¿Estás seguro de que deseas reemplazarlo por uno nuevo?
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center;">
                <!-- Botón cambiado a rojo con texto blanco -->
                <button id="btnConfirmChangeClient" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #ef4444; color: white; border: none; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
                    Sí, cambiar
                </button>
                <button id="btnCancelChangeClient" style="flex: 1; padding: 0.875rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; background: #2a204d; color: white; border: 1px solid rgba(255, 255, 255, 0.1); transition: background 0.2s;" onmouseover="this.style.background='#36295e'" onmouseout="this.style.background='#2a204d'">
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <div id="toastNotif" class="toast-notif" style="display: none;"><span id="toastMsg">Operación exitosa</span></div>

    <ClienteModal />
    <ProductoModal />
</MainLayout>

<style>
    /* Contenedor principal */
    .page-content { padding: 0; width: 100%; box-sizing: border-box; }
    
    .page-header-top { margin-bottom: 1.5rem; }
    .page-header-title { color: white; font-size: 2rem; font-weight: 800; margin: 0; letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px;}

    /* Estilos del Dashboard */
    .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; height: 100%; align-content: start; }
    .column-left, .column-right { display: flex; flex-direction: column; }
    .full-width-footer { grid-column: 1 / -1; margin-top: 0.5rem; }
    .mb-4 { margin-bottom: 1rem; }
    .panel-fill { flex: 1; display: flex; flex-direction: column; }

    .glass-card { background: rgba(30, 20, 60, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1.25rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
    .glass-panel { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 1rem; padding: 1rem; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.3); }

    .panel-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.6rem; color: white; }
    .panel-subtitle { font-size: 0.8rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.1em; }

    .btn-glass { background: #7c3aed; color: white; border: none; padding: 0.7rem 1.2rem; border-radius: 1rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.6rem; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(124, 58, 237, 0.2); }
    .btn-glass:hover { background: #6d28d9; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4); }

    .btn-primary { background: #7c3aed; color: white; border: none; padding: 0.7rem 1.2rem; border-radius: 0.6rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.6rem; transition: all 0.3s ease; }
    .btn-primary:hover { background: #6d28d9; transform: translateY(-2px); box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4); }
    .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; box-shadow: none; }

    .btn-danger { background: #ef4444; color: white; border: none; padding: 10px 20px; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-danger:hover { background: #dc2626; transform: translateY(-1px); }
    .btn-secondary { background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255, 255, 255, 0.1); padding: 10px 20px; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-secondary:hover { background: rgba(255,255,255,0.1); }
    .btn-large { width: 100%; font-size: 1.1rem; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .full-width { grid-column: 1 / -1; }
    .input-wrapper { display: flex; flex-direction: column; gap: 0.5rem; }
    .input-wrapper label { font-size: 0.8rem; color: #94a3b8; font-weight: 500; }
    
    .input-wrapper input { background: rgba(0,0,0,0.2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 0.6rem; padding: 0.8rem; color: white; outline: none; transition: all 0.2s; font-size: 0.95rem; }
    .input-wrapper input:focus { border-color: #7c3aed; background: rgba(0,0,0,0.4); }
    
    .readonly-field { background: rgba(0, 0, 0, 0.4) !important; color: white !important; cursor: not-allowed; border-color: transparent !important; font-weight: 400; pointer-events: none; user-select: none; }

    .totales-panel { display: flex; flex-direction: column; gap: 1rem; padding: 1.2rem 1.5rem; }
    .totales-info { display: flex; flex-direction: column; gap: 0.4rem; }
    .total-row { display: flex; justify-content: space-between; font-size: 0.95rem; color: #94a3b8; align-items: center; }
    .grand-total { font-size: 1.25rem; font-weight: 800; color: white; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 0.6rem; margin-top: 0.3rem; }

    .totales-action { width: 100%; }
    .text-center { text-align: center; }
    
    .toast-notif { position: fixed; bottom: 30px; right: 30px; color: white; padding: 12px 24px; border-radius: 8px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 3000; animation: slideInUp 0.3s ease; }
    .spinner-small { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite; }
    
    @keyframes slideInUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    @keyframes spin { to { transform: rotate(360deg); } }

    .modal-overlay { 
        position: fixed; 
        top: 0; left: 0; right: 0; bottom: 0; 
        background: rgba(10, 5, 25, 0.85); 
        backdrop-filter: blur(8px); 
        -webkit-backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center; 
        z-index: 2000; animation: fadeIn 0.2s ease-out;
    }
    
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

<style is:global>
    /* ====== CONTENEDOR CON SCROLL FIJO ====== */
    #contenedorTablaOrden {
        flex: 1; 
        min-height: 220px;
        max-height: 330px;
        overflow-y: auto !important;
        border: none;
        background: transparent;
        position: relative;
        margin-top: 0.5rem;
    }

    #contenedorTablaOrden::-webkit-scrollbar { width: 6px; }
    #contenedorTablaOrden::-webkit-scrollbar-track { background: transparent; }
    #contenedorTablaOrden::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
    #contenedorTablaOrden::-webkit-scrollbar-thumb:hover { background: rgba(124, 58, 237, 0.5); }

    /* ====== TABLA Y ENCABEZADO FIJO ====== */
    .dark-table { width: 100%; border-collapse: collapse !important; text-align: left; }
    .dark-table th { 
        background: rgba(30, 20, 60, 0.98) !important;
        backdrop-filter: blur(10px); 
        color: #94a3b8; 
        font-size: 0.75rem; 
        text-transform: uppercase; 
        padding: 0.8rem 1rem; 
        border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
        letter-spacing: 0.05em; 
        position: sticky !important; 
        top: 0 !important; 
        z-index: 10 !important; 
        box-shadow: 0 4px 10px -4px rgba(0,0,0,0.5);
    }
    .dark-table td { padding: 0.8rem 1rem; font-size: 0.9rem; border-bottom: 1px solid rgba(255, 255, 255, 0.03); vertical-align: middle; color: #e2e8f0; transition: background 0.2s; }
    .dark-table tbody tr:hover td { background: rgba(124, 58, 237, 0.05); }

    /* ====== INPUT DE CANTIDAD REFINADO ====== */
    .input-cant { width: 70px; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1); color: white; padding: 0.4rem 0.6rem; border-radius: 0.4rem; text-align: right; font-weight: 600; font-size: 0.95rem; transition: all 0.2s; }
    .input-cant:focus { border-color: #7c3aed; outline: none; background: rgba(0, 0, 0, 0.5); box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2); }

    /* ====== BOTÓN ELIMINAR MINIMALISTA ====== */
    .btn-del { background: transparent !important; border: none !important; color: #ef4444 !important; width: 32px; height: 32px; border-radius: 6px; cursor: pointer; display: inline-flex !important; align-items: center; justify-content: center; transition: all 0.2s ease; padding: 0; }
    .btn-del:hover { background: rgba(239, 68, 68, 0.1) !important; color: #f87171 !important; }

    .text-empty { color: #64748b; font-size: 0.95rem; border-bottom: none !important; }

    /* ========================================================
       ESTILOS EXCLUSIVOS PARA IMPRESIÓN / DESCARGA PDF 
       ======================================================== */
    .print-only { display: none; }
    
    @media print {
        @page { size: A4; margin: 20mm; }
        
        body { background: white !important; }
        .sidebar, .topbar, .no-print, .dashboard-grid, .modal-overlay, #toastNotif, .topbar-badge { 
            display: none !important; 
        }

        .print-only {
            display: block !important;
            color: black !important;
            font-family: 'Arial', sans-serif !important;
            width: 100% !important;
            position: absolute;
            left: 0; top: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        .invoice-header { display: flex; justify-content: space-between; border-bottom: 2px solid #333; padding-bottom: 20px; margin-bottom: 30px; }
        .invoice-logo h2 { margin: 0; font-size: 24px; color: #2d1b63 !important; }
        .invoice-logo p { margin: 5px 0 0 0; color: #666 !important; font-size: 14px; }
        .invoice-details { text-align: right; }
        .invoice-details p { margin: 3px 0; font-size: 14px; }
        
        .invoice-billing { display: flex; justify-content: space-between; margin-bottom: 40px; }
        .invoice-billing h3 { margin: 0 0 10px 0; font-size: 16px; color: #333 !important; border-bottom: 1px solid #ccc; padding-bottom: 5px;}
        .invoice-billing p { margin: 3px 0; font-size: 14px; }
        
        .invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .invoice-table th { background-color: #f3f4f6 !important; color: #333 !important; font-weight: bold; padding: 12px 8px; border-bottom: 2px solid #ccc; font-size: 14px; text-align: left; }
        .invoice-table td { padding: 10px 8px; border-bottom: 1px solid #eee; font-size: 14px; }
        
        .invoice-totals { width: 50%; float: right; margin-bottom: 40px; }
        .totals-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 15px; }
        .totals-grand { font-size: 18px; font-weight: bold; border-top: 2px solid #333; padding-top: 10px; margin-top: 5px;}
        
        .invoice-footer { clear: both; text-align: center; color: #666 !important; font-size: 13px; border-top: 1px solid #ccc; padding-top: 20px; }
    }
</style>

<script is:inline>
    function inicializarModuloOrden() {
        if (!document.getElementById('customerCedula')) return;
        const token = localStorage.getItem('northwind_token');
        if (!token) {
            window.location.href = '/login';
            return;
        }

        const API_URL = "https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/CreateOrder";
        const cuerpoTabla = document.getElementById('listaProductosCuerpo');
        const filaVacia = document.getElementById('filaVacia');
        let urlDestinoSalida = ''; 
        let numeroFacturaActual = "---";
        
        // Variables globales para los modales de confirmación
        let filaAEliminar = null;

        const btnGuardarViejo = document.getElementById('btnGuardarOrden');
        const btnGuardarOrden = btnGuardarViejo.cloneNode(true);
        btnGuardarViejo.parentNode.replaceChild(btnGuardarOrden, btnGuardarViejo);

        async function fetchSiguienteNumeroFactura() {
            try {
                const res = await fetch("https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/api/orders", {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    const orders = await res.json();
                    let maxId = 0;
                    if (orders && orders.length > 0) {
                        maxId = Math.max(...orders.map(o => o.id || o.orderId || o.Id || o.OrderId || 0));
                    }
                    numeroFacturaActual = maxId + 1;
                    
                    const displaySpan = document.getElementById('displayInvoiceNumber');
                    if (displaySpan) displaySpan.textContent = numeroFacturaActual;
                }
            } catch (e) {
                console.error("Error al obtener número de factura", e);
            }
        }

        fetchSiguienteNumeroFactura();

        function hayDatosSinGuardar() {
            const elCliente = document.getElementById('internalCustomerId');
            if (!elCliente) return false; 
            const tieneCliente = elCliente.value.trim() !== '';
            const tieneProductos = document.querySelectorAll('.item-venta').length > 0;
            return tieneCliente || tieneProductos;
        }

        if (window.interceptarNavegacionRegistrada) { document.removeEventListener('click', window.interceptarNavegacionRegistrada, true); }

        window.interceptarNavegacionRegistrada = function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                const url = new URL(link.href);
                if (url.origin === window.location.origin && url.pathname !== window.location.pathname) {
                    if (hayDatosSinGuardar()) {
                        e.preventDefault();
                        e.stopPropagation(); 
                        urlDestinoSalida = link.href; 
                        document.getElementById('leaveConfirmModal').style.display = 'flex'; 
                    }
                }
            }
        };
        document.addEventListener('click', window.interceptarNavegacionRegistrada, true);

        if (window.manejadorAstroNav) { document.removeEventListener('astro:before-preparation', window.manejadorAstroNav); }
        window.manejadorAstroNav = (e) => {
            if (hayDatosSinGuardar()) {
                e.preventDefault();
                urlDestinoSalida = e.to.href;
                document.getElementById('leaveConfirmModal').style.display = 'flex';
            }
        };
        document.addEventListener('astro:before-preparation', window.manejadorAstroNav);
        
        window.onbeforeunload = function(e) {
            if (hayDatosSinGuardar()) {
                e.preventDefault();
                e.returnValue = ''; 
            }
        };
        
        document.getElementById('btnCancelLeave').onclick = () => {
            document.getElementById('leaveConfirmModal').style.display = 'none';
            urlDestinoSalida = '';
        };

        document.getElementById('btnConfirmLeave').onclick = () => {
            window.onbeforeunload = null;
            document.removeEventListener('click', window.interceptarNavegacionRegistrada, true);
            document.removeEventListener('astro:before-preparation', window.manejadorAstroNav);
            window.location.href = urlDestinoSalida;
        };

        // --- LÓGICA MODAL CONFIRMAR ELIMINAR PRODUCTO ---
        document.getElementById('btnCancelDeleteProduct').onclick = () => {
            document.getElementById('deleteProductConfirmModal').style.display = 'none';
            filaAEliminar = null;
        };

        document.getElementById('btnConfirmDeleteProduct').onclick = () => {
            if (filaAEliminar) {
                filaAEliminar.remove();
                if (cuerpoTabla.querySelectorAll('.item-venta').length === 0) {
                    filaVacia.style.display = 'table-row';
                }
                actualizarTotales();
                filaAEliminar = null;
            }
            document.getElementById('deleteProductConfirmModal').style.display = 'none';
        };

        // --- LÓGICA MODAL CONFIRMAR CAMBIAR CLIENTE ---
        document.getElementById('btnCancelChangeClient').onclick = () => {
            document.getElementById('changeClientConfirmModal').style.display = 'none';
        };

        document.getElementById('btnConfirmChangeClient').onclick = () => {
            document.getElementById('changeClientConfirmModal').style.display = 'none';
            if (typeof window.abrirModalClientes === 'function') window.abrirModalClientes();
        };


        function agregarFilaProducto(pId, pName, pDescription, pPrice, pStock, qty = 1) {
            if (filaVacia) filaVacia.style.display = 'none';
            const row = document.createElement('tr');
            row.className = 'item-venta';
            row.setAttribute('data-id', pId);
            row.setAttribute('data-name', pName); 
            row.setAttribute('data-price', pPrice);
            
            const timestamp = new Date().getTime();
            const imageUrl = `https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/api/products/${pId}/image?t=${timestamp}`;
            const iconProduct = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px;">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            `;
            
            row.innerHTML = `
                <td style="color: #a78bfa; font-weight: 600; font-family: monospace; font-size: 1rem;">#${pId}</td>
                <td style="font-weight: 500;" title="${pName}">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <img src="${imageUrl}" style="width: 40px; height: 40px; border-radius: 0.5rem; object-fit: cover; border: 2px solid rgba(124, 58, 237, 0.3);" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div style="width: 40px; height: 40px; border-radius: 0.5rem; background: rgba(124, 58, 237, 0.2); color: #a78bfa; display: none; align-items: center; justify-content: center; border: 2px solid rgba(124, 58, 237, 0.3);">${iconProduct}</div>
                        <span>${pName}</span>
                    </div>
                </td>
                <td style="color: #94a3b8; font-size: 0.85rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${pDescription || ''}">${pDescription || 'Sin descripción'}</td>
                <td style="text-align: right; color: #cbd5e1;">$${pPrice.toFixed(2)}</td>
                <td style="text-align: right;">
                    <input type="number" class="input-cant" style="margin-left: auto; display: block; text-align: right;" value="${qty}" min="1" max="${pStock}">
                </td>
                <td class="subtotal-fila" style="text-align: right; font-weight: 600; color: white;">$${(pPrice * qty).toFixed(2)}</td>
                <td style="text-align: center;">
                    <button type="button" class="btn-del" title="Quitar producto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                        </svg>
                    </button>
                </td>
            `;

            row.querySelector('.btn-del').onclick = () => {
                filaAEliminar = row;
                document.getElementById('deleteProductNameDisplay').textContent = pName;
                document.getElementById('deleteProductConfirmModal').style.display = 'flex';
            };
            
            const inputCant = row.querySelector('.input-cant');
            inputCant.oninput = (ev) => {
                let cant = parseInt(ev.target.value) || 0;
                if (cant > pStock) {
                    cant = pStock;
                    ev.target.value = pStock;
                }
                if (cant < 1 && ev.target.value !== "") {
                    cant = 1;
                    ev.target.value = 1;
                }
                const totalFila = cant * pPrice;
                row.querySelector('.subtotal-fila').textContent = `$${totalFila.toFixed(2)}`;
                actualizarTotales();
            };

            cuerpoTabla.appendChild(row);
            actualizarTotales();
        }

        function actualizarTotales() {
            let subtotal = 0;
            document.querySelectorAll('.subtotal-fila').forEach(el => {
                subtotal += parseFloat(el.textContent.replace('$', '')) || 0;
            });
            
            const ivaPorcentaje = 0.15; 
            const iva = subtotal * ivaPorcentaje;
            const total = subtotal + iva;

            document.getElementById('txtSubtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('txtIva').textContent = `$${iva.toFixed(2)}`;
            document.getElementById('txtTotal').textContent = `$${total.toFixed(2)}`;
        }

        const btnBuscarCliente = document.getElementById('btnBuscarCliente');
        if (btnBuscarCliente) {
            btnBuscarCliente.addEventListener('click', () => {
                const currentClient = document.getElementById('internalCustomerId').value;
                if (currentClient.trim() !== '') {
                    // Si ya hay un cliente, mostrar confirmación
                    document.getElementById('changeClientConfirmModal').style.display = 'flex';
                } else {
                    // Si no hay cliente, abrir directamente
                    if (typeof window.abrirModalClientes === 'function') window.abrirModalClientes();
                }
            });
        }
        
        document.getElementById('btnBuscarProducto')?.addEventListener('click', () => {
            if (typeof window.abrirModalProductos === 'function') window.abrirModalProductos();
        });
        
        // --- VALIDACIÓN CÓDIGO POSTAL ---
        const inputPostal = document.getElementById('shipPostalCode');
        if (inputPostal) {
            inputPostal.addEventListener('keydown', (e) => {
                // Permitir teclas de control: Borrar, Flechas, Tabulador, Enter y combinaciones (Ctrl+V, Ctrl+C)
                if (['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Enter'].includes(e.key) || e.ctrlKey || e.metaKey) {
                    return;
                }
                // Si la tecla no es un número del 0 al 9 o es un espacio, bloquearla
                if (e.key === ' ' || !/^[0-9]$/.test(e.key)) {
                    e.preventDefault();
                }
            });
            // Limpieza en caso de que logren pegar texto
            inputPostal.addEventListener('input', (e) => {
                e.target.value = e.target.value.replace(/\D/g, '').substring(0, 5);
            });
        }
        
        // --- MAPEO DE DATOS AUTOMÁTICO ---
        window.removeEventListener('clienteSeleccionado', window.handleClienteSelection);
        window.handleClienteSelection = (e) => {
            const cliente = e.detail;
            
            // Asignamos ID interno para base de datos y Cédula para la UI
            document.getElementById('internalCustomerId').value = cliente.id || cliente.Id || cliente.customerId || cliente.CustomerId || '';
            document.getElementById('customerCedula').value = cliente.cedula || cliente.Cedula || 'N/A';
            
            document.getElementById('firstName').value = cliente.firstName || cliente.FirstName || '';
            document.getElementById('lastName').value = cliente.lastName || cliente.LastName || '';
            document.getElementById('email').value = cliente.email || cliente.Email || 'No registrado';
            document.getElementById('phone').value = cliente.phone || cliente.Phone || 'Sin teléfono';
            document.getElementById('shipCity').value = cliente.city || cliente.City || 'Sin ciudad registrada';
            document.getElementById('shipAddress').value = cliente.address || cliente.Address || '';
            document.getElementById('shipPostalCode').value = cliente.postalCode || cliente.PostalCode || '';
        };
        window.addEventListener('clienteSeleccionado', window.handleClienteSelection);

        window.removeEventListener('productoSeleccionado', window.handleProductoSelection);
        window.handleProductoSelection = (e) => {
            const p = e.detail;
            agregarFilaProducto(
                String(p.id || p.Id).trim(),
                p.name || p.Name,
                p.description || p.Description,
                Number(p.unitPrice || p.UnitPrice || 0),
                Number(p.unitsInStock ?? p.UnitsInStock ?? 0),
                1
            );
        };
        window.addEventListener('productoSeleccionado', window.handleProductoSelection);

        btnGuardarOrden.addEventListener('click', async () => {
            
            const internalCustomerId = document.getElementById('internalCustomerId').value;
            const customerCedula = document.getElementById('customerCedula').value;
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const shipCity = document.getElementById('shipCity').value.trim();
            const shipAddress = document.getElementById('shipAddress').value.trim();
            const shipPostalCode = document.getElementById('shipPostalCode').value.trim();

            if (!internalCustomerId || !firstName || !lastName || !shipCity) {
                mostrarNotificacion("Por favor, seleccione un cliente de la lista.", "error");
                return;
            }
            if (!shipAddress || !shipPostalCode) {
                mostrarNotificacion("La dirección y el código postal son obligatorios.", "error");
                return;
            }

            const arrayDetalles = [];
            const filas = document.querySelectorAll('.item-venta');

            filas.forEach((fila) => {
                const id = parseInt(fila.getAttribute('data-id'));
                const name = fila.getAttribute('data-name'); 
                const precio = parseFloat(fila.getAttribute('data-price'));
                const cantidad = parseInt(fila.querySelector('.input-cant').value);

                if (id > 0 && cantidad > 0) {
                    arrayDetalles.push({ productId: id, name: name, unitPrice: precio, quantity: cantidad });
                }
            });

            if (arrayDetalles.length === 0) {
                mostrarNotificacion("Debe agregar al menos un producto a la orden.", "error");
                return;
            }

            mostrarCargaBoton(true);
            
            const ivaPorcentaje = 0.15;
            
            const payload = {
                customerId: internalCustomerId, 
                shipAddress: shipAddress, 
                shipCity: shipCity, 
                shipCountry: 'N/A',
                shipPostalCode: shipPostalCode, 
                ivaRate: ivaPorcentaje, 
                orderDetails: arrayDetalles.map(d => ({ 
                    productId: d.productId, 
                    unitPrice: d.unitPrice, 
                    quantity: d.quantity 
                })) 
            };

            try {
                const response = await fetch(API_URL, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });
                
                if (response.ok) {
                    const dataRespuesta = await response.json();
                    const idFacturaReal = dataRespuesta.orderId || dataRespuesta.OrderId || numeroFacturaActual;

                    mostrarNotificacion("¡Orden guardada con éxito! Generando factura...", "success");
                    
                    // Pasamos la Cédula para que se imprima
                    llenarFacturaImprimible(customerCedula, firstName, lastName, email, phone, shipCity, shipAddress, shipPostalCode, arrayDetalles, ivaPorcentaje, idFacturaReal);

                    window.onbeforeunload = null;
                    document.removeEventListener('click', window.interceptarNavegacionRegistrada, true);
                    document.removeEventListener('astro:before-preparation', window.manejadorAstroNav);

                    document.querySelectorAll('input[type="text"]').forEach(i => i.value = '');
                    document.getElementById('internalCustomerId').value = '';
                    
                    document.querySelectorAll('.item-venta').forEach(f => f.remove());
                    if(filaVacia) filaVacia.style.display = 'table-row';
                    actualizarTotales();

                    const displaySpan = document.getElementById('displayInvoiceNumber');
                    if (displaySpan) displaySpan.textContent = idFacturaReal;

                    setTimeout(() => {
                        window.print();
                        
                        setTimeout(() => {
                            fetchSiguienteNumeroFactura();
                            inicializarModuloOrden();
                        }, 500); 
                    }, 800);

                } else {
                    if(response.status === 401) {
                        mostrarNotificacion("Sesión expirada. Vuelve a iniciar sesión.", "error");
                    } else {
                        try {
                            const errorData = await response.json();
                            let mensajeError = errorData.error || errorData.message || errorData.detail || "Error de validación en el servidor.";
                            if (errorData.errors) {
                                const primerCampo = Object.keys(errorData.errors)[0];
                                mensajeError = errorData.errors[primerCampo][0];
                            }
                            
                            const msjLower = mensajeError.toLowerCase();
                            let mostroErrorPersonalizado = false;
                            
                            if (msjLower.includes('stock') || msjLower.includes('inventario') || 
                                msjLower.includes('eliminad') || msjLower.includes('exist') || 
                                msjLower.includes('encontrad') || msjLower.includes('foreign key') || 
                                msjLower.includes('referen') || msjLower.includes('product')) {
                                
                                try {
                                    const resProd = await fetch('https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/api/products');
                                    
                                    if (resProd.ok) {
                                        const productosActuales = await resProd.json();
                                        let problemaEncontrado = false;
                                        const filas = document.querySelectorAll('.item-venta');
                                        
                                        for (let fila of filas) {
                                            const id = parseInt(fila.getAttribute('data-id'));
                                            const name = fila.getAttribute('data-name');
                                            const inputCant = fila.querySelector('.input-cant');
                                            const cantSolicitada = parseInt(inputCant.value);
                                            
                                            const prodEnBd = productosActuales.find(p => (p.id || p.Id) == id);
                                            
                                            if (!prodEnBd) {
                                                // Aumentamos a 8 segundos (8000 ms) y no borramos la fila automáticamente
                                                mostrarNotificacion(`⚠️ El producto "${name}" ya fue eliminado por un administrador. Por favor, elimínalo de la orden.`, "error", 8000);
                                                problemaEncontrado = true;
                                            } else {
                                                const stockReal = Number(prodEnBd.unitsInStock ?? prodEnBd.UnitsInStock ?? 0);
                                                if (stockReal < cantSolicitada) {
                                                    if (stockReal <= 0) {
                                                        // Aumentamos a 8 segundos y no borramos la fila automáticamente
                                                        mostrarNotificacion(`⚠️ El producto "${name}" ya está sin stock en este momento. Por favor, elimínalo de la orden.`, "error", 8000);
                                                    } else {
                                                        mostrarNotificacion(`⚠️ Solo quedan ${stockReal} unidades disponibles de "${name}". Tu orden ha sido ajustada.`, "warning", 8000);
                                                        inputCant.value = stockReal;
                                                        inputCant.dispatchEvent(new Event('input')); 
                                                    }
                                                    problemaEncontrado = true;
                                                }
                                            }
                                        }
                                        
                                        if (problemaEncontrado) {
                                            actualizarTotales();
                                            mostroErrorPersonalizado = true;
                                        }
                                    }
                                } catch(e) {
                                    console.error("No se pudo re-verificar el stock silenciosamente", e);
                                }
                            }

                            if (!mostroErrorPersonalizado) {
                                if (msjLower.includes('client') || msjLower.includes('customer') || msjLower.includes('foreign key') || msjLower.includes('referen')) {
                                    mostrarNotificacion(`⚠️ El cliente seleccionado parece haber sido eliminado. Por favor, búscalo nuevamente.`, "error");
                                    document.getElementById('internalCustomerId').value = '';
                                    document.getElementById('customerCedula').value = '';
                                    document.getElementById('firstName').value = '';
                                    document.getElementById('lastName').value = '';
                                    document.getElementById('email').value = '';
                                    document.getElementById('phone').value = '';
                                    document.getElementById('shipCity').value = '';
                                    document.getElementById('shipAddress').value = '';
                                    document.getElementById('shipPostalCode').value = '';
                                } else {
                                    mostrarNotificacion(`❌ No se pudo crear la orden: ${mensajeError}`, "error");
                                }
                            }

                        } catch (e) {
                            mostrarNotificacion("Error crítico al guardar la orden. Intente nuevamente.", "error");
                        }
                    }
                }
            } catch (error) {
                mostrarNotificacion("No se pudo conectar con el servidor.", "error");
                console.error(error);
            } finally {
                mostrarCargaBoton(false);
            }
        });

        function llenarFacturaImprimible(cedula, nombre, apellido, correo, telefono, ciudad, direccion, codigoPostal, detalles, ivaPorcentaje, numeroFactura) {
            document.getElementById('printInvoiceNumber').textContent = numeroFactura;
            document.getElementById('printDate').textContent = new Date().toLocaleDateString();
            
            // Asignamos la cédula para la impresión
            document.getElementById('printCustomerCedula').textContent = cedula;
            
            document.getElementById('printFullName').textContent = `${nombre} ${apellido}`.trim();
            document.getElementById('printEmail').textContent = correo;
            document.getElementById('printPhone').textContent = telefono;
            document.getElementById('printCity').textContent = ciudad;
            document.getElementById('printAddress').textContent = direccion;
            document.getElementById('printPostalCode').textContent = codigoPostal;

            const userName = localStorage.getItem('northwind_user_name') || 'Usuario del Sistema';
            
            let userEmail = '';
            if (token) {
                try {
                    const base64Url = token.split('.')[1];
                    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                    const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                    }).join(''));
                    const payloadObj = JSON.parse(jsonPayload);
                    
                    userEmail = payloadObj.email || 
                                payloadObj["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"] || 
                                payloadObj["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"] || 
                                '';
                } catch(e) {
                    console.error("No se pudo decodificar el token para el correo.");
                }
            }

            const printIssuerName = document.getElementById('printIssuerName');
            const printIssuerEmail = document.getElementById('printIssuerEmail');
            
            if (printIssuerName) printIssuerName.textContent = userName;
            if (printIssuerEmail) {
                if (userEmail) {
                    printIssuerEmail.textContent = userEmail;
                } else {
                    printIssuerEmail.style.display = 'none'; 
                }
            }

            const printBody = document.getElementById('printTableBody');
            printBody.innerHTML = '';
            
            let subtotal = 0;
            detalles.forEach(d => {
                const sub = d.unitPrice * d.quantity;
                subtotal += sub;
                printBody.innerHTML += `
                    <tr>
                        <td style="text-align: left;">${d.productId}</td>
                        <td style="text-align: left;">${d.name}</td>
                        <td style="text-align: center;">${d.quantity}</td>
                        <td style="text-align: right;">$${d.unitPrice.toFixed(2)}</td>
                        <td style="text-align: right;">$${sub.toFixed(2)}</td>
                    </tr>
                `;
            });

            const iva = subtotal * ivaPorcentaje;
            const total = subtotal + iva;

            document.getElementById('printIvaLabel').textContent = `IVA (${(ivaPorcentaje * 100)}%):`;
            document.getElementById('printSubtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('printIva').textContent = `$${iva.toFixed(2)}`;
            document.getElementById('printTotal').textContent = `$${total.toFixed(2)}`;
        }

        // Agregada la variable duración (por defecto 4000ms)
        function mostrarNotificacion(mensaje, tipo = 'success', duracion = 4000) {
            const toast = document.getElementById('toastNotif');
            if(!toast) return;
            document.getElementById('toastMsg').textContent = mensaje;
            
            if (tipo === 'error') {
                toast.style.backgroundColor = '#ef4444';
                toast.style.border = '1px solid #b91c1c';
            } else if (tipo === 'warning') {
                toast.style.backgroundColor = '#eab308';
                toast.style.border = '1px solid #a16207';
            } else {
                toast.style.backgroundColor = '#10b981';
                toast.style.border = '1px solid #047857';
            }
            
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, duracion);
        }

        function mostrarCargaBoton(isCargando) {
            const btnText = document.getElementById('btnGuardarText');
            const btnSpinner = document.getElementById('btnSpinner');
            document.getElementById('btnGuardarOrden').disabled = isCargando;
            if(isCargando) {
                btnText.style.display = 'none';
                btnSpinner.style.display = 'block';
            } else {
                btnText.style.display = 'flex';
                btnSpinner.style.display = 'none';
            }
        }
    }

    document.addEventListener('astro:page-load', inicializarModuloOrden);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', inicializarModuloOrden);
    } else {
        inicializarModuloOrden();
    }
</script>