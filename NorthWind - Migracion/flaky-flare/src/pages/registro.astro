const eyeIconClosed = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="currentColor" d="M1.3 1.1c.3-.3.9-.3 1.1 0l16.3 16.3c.3.3.3.9 0 1.1s-.9.3-1.1 0L1.3 2.2c-.3-.3-.3-.9 0-1.1zm3.8 3.8l1.4 1.4C5.1 7 4.1 8.4 3.6 10c.8 2.2 2.9 3.8 5.4 3.8.9 0 1.7-.2 2.4-.6l1.5 1.5C11.9 15.3 11 15.7 10 15.7 6.1 15.7 2.8 13.5 1.4 10c.8-2 2.2-3.6 3.8-5zm11.1 11.1l-1.4-1.4C14.9 13 15.9 11.6 16.4 10c-.8-2.2-2.9-3.8-5.4-3.8-.9 0-1.7.2-2.4.6l-1.5-1.5C8.1 4.7 9 4.3 10 4.3c3.9 0 7.2 2.2 8.6 5.7-.8 2-2.2 3.6-3.8 5zm-3.4-3.4l1.3 1.3a3.5 3.5 0 01-4.7-4.7l1.3 1.3a1.5 1.5 0 002.1 2.1z"/></svg>';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta | NorthWind</title>
    <style>
        /* Paleta Profesional y Reset */
        :root {
            --bg-page-top: #1a103c;
            --bg-page-bottom: #2d1b63;
            --card-bg: rgba(255, 255, 255, 0.03);
            --card-border: rgba(255, 255, 255, 0.08);
            --primary: #7c3aed; 
            --primary-hover: #6d28d9;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(0, 0, 0, 0.2);
            --input-border: rgba(255, 255, 255, 0.1);
            --input-focus: rgba(124, 58, 237, 0.5);
            
            /* Colores para mensajes */
            --error-bg: rgba(220, 38, 38, 0.1);
            --error-border: rgba(220, 38, 38, 0.3);
            --error-text: #fca5a5;
            --success-bg: rgba(22, 163, 74, 0.1);
            --success-border: rgba(22, 163, 74, 0.3);
            --success-text: #86efac;
        }

        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }

        body { 
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: linear-gradient(135deg, var(--bg-page-top) 0%, var(--bg-page-bottom) 100%); 
            color: var(--text-main); 
            min-height: 100vh; /* min-height para permitir scroll si la pantalla es pequeña */
            display: flex; 
            align-items: center; 
            justify-content: center; 
            padding: 2rem 1rem;
        }

        /* Tarjeta Premium */
        .register-card { 
            background: var(--card-bg); 
            backdrop-filter: blur(24px); 
            -webkit-backdrop-filter: blur(24px); 
            border: 1px solid var(--card-border); 
            border-radius: 1.25rem; 
            padding: 3rem; 
            width: 100%; 
            max-width: 500px; /* Un poco más ancha que el login para las dos columnas */
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.02) inset; 
        }

        .header-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .header-section h1 { 
            font-size: 1.875rem; 
            font-weight: 700; 
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem; 
            color: #ffffff;
        }

        .header-section p { 
            color: var(--text-muted); 
            font-size: 0.95rem; 
        }

        /* Formulario Estructurado */
        form { 
            display: flex; 
            flex-direction: column; 
            gap: 1.25rem; 
        }

        /* Fila para Nombre y Apellido */
        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .input-group { 
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            text-align: left;
        }

        .input-group label {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper input { 
            width: 100%; 
            background: var(--input-bg); 
            border: 1px solid var(--input-border); 
            border-radius: 0.5rem; 
            padding: 0.875rem 1rem; 
            color: var(--text-main); 
            font-size: 1rem; 
            outline: none;
            transition: all 0.2s ease;
        }

        .input-wrapper input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--input-focus);
            background: rgba(0, 0, 0, 0.3);
        }

        .input-wrapper input::placeholder { 
            color: rgba(148, 163, 184, 0.5); 
        }

        /* Botón de Contraseña */
        .password-wrapper input { 
            padding-right: 3rem; 
        }
        
        .password-toggle { 
            position: absolute; 
            right: 0.75rem; 
            top: 50%; 
            transform: translateY(-50%); 
            background: none; 
            border: none; 
            cursor: pointer; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            padding: 0.25rem;
            color: var(--text-muted);
            transition: color 0.2s;
        }

        .password-toggle:hover { color: var(--text-main); }
        .password-toggle .eye-closed { display: none; }
        .password-toggle.is-hidden .eye-open { display: none; }
        .password-toggle.is-hidden .eye-closed { display: block; }

        /* Botón de Envío Corporativo */
        .btn-submit { 
            background-color: var(--primary); 
            border: 1px solid rgba(255,255,255,0.1) inset; 
            border-radius: 0.5rem; 
            padding: 0.875rem; 
            color: white; 
            font-weight: 600; 
            font-size: 1rem; 
            cursor: pointer; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            margin-top: 0.5rem; 
            width: 100%; 
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .btn-submit:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.4); 
        }

        .btn-submit:active {
            transform: translateY(1px);
            box-shadow: 0 2px 10px rgba(168, 85, 247, 0.3);
        }
        
        .btn-submit:disabled {
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 0.7;
        }

        /* Footer del formulario */
        .form-footer { 
            text-align: center;
            margin-top: 2rem; 
            padding-top: 1.5rem;
            border-top: 1px solid var(--card-border);
        }

        .form-footer p {
            color: var(--text-muted); 
            font-size: 0.875rem; 
        }

        .form-footer a { 
            color: #a78bfa; 
            text-decoration: none; 
            font-weight: 500; 
            transition: color 0.2s;
            margin-left: 0.25rem;
        }

        .form-footer a:hover { 
            color: #c4b5fd;
            text-decoration: underline; 
        }

        /* Estilos de mensajes dinámicos */
        .mensaje-alerta {
            padding: 0.875rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
            text-align: center;
            backdrop-filter: blur(10px);
            display: none;
        }

        .mensaje-error {
            background-color: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
        }

        .mensaje-exito {
            background-color: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
        }
    </style>
</head>
<body>
    <div class="register-card">
        
        <div class="header-section">
            <h1>Crear cuenta</h1>
            <p>Únete a NorthWind para comenzar</p>
        </div>

        <div id="alertaRegistro" class="mensaje-alerta"></div>

        <form id="registroForm">
            
            <div class="row">
                <div class="input-group">
                    <label for="firstName">Nombre</label>
                    <div class="input-wrapper">
                        <input type="text" id="firstName" name="firstName" placeholder="Tu nombre" required maxlength="15" pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+$" title="Solo letras y espacios, máximo 15 caracteres">
                    </div>
                </div>

                <div class="input-group">
                    <label for="lastName">Apellidos</label>
                    <div class="input-wrapper">
                        <input type="text" id="lastName" name="lastName" placeholder="Tus apellidos" required maxlength="15" pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+$" title="Solo letras y espacios, máximo 15 caracteres">
                    </div>
                </div>
            </div>

            <div class="input-group">
                <label for="email">Correo electrónico</label>
                <div class="input-wrapper">
                    <input type="email" id="email" name="email" placeholder="ejemplo@empresa.com" required>
                </div>
            </div>

            <div class="input-group">
                <label for="password">Contraseña</label>
                <div class="input-wrapper password-wrapper">
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                    <button type="button" class="password-toggle" id="togglePass1" aria-label="Mostrar contraseña">
                        <span class="eye-open" set:html={eyeIconOpen}></span>
                        <span class="eye-closed" set:html={eyeIconClosed}></span>
                    </button>
                </div>
            </div>

            <div class="input-group">
                <label for="confirmPassword">Confirmar contraseña</label>
                <div class="input-wrapper password-wrapper">
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>
                    <button type="button" class="password-toggle" id="togglePass2" aria-label="Mostrar contraseña">
                        <span class="eye-open" set:html={eyeIconOpen}></span>
                        <span class="eye-closed" set:html={eyeIconClosed}></span>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-submit">Registrarse</button>
        </form>

        <div class="form-footer">
            <p>¿Ya tienes una cuenta?<a href="/login">Inicia sesión aquí</a></p>
        </div>

    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('registroForm');
            const btnSubmit = document.querySelector('.btn-submit');
            const alertaDiv = document.getElementById('alertaRegistro');

            // Función para los botones del ojito en ambas contraseñas
            function setupPasswordToggle(inputId, toggleId) {
                const input = document.getElementById(inputId);
                const toggle = document.getElementById(toggleId);
                
                toggle.addEventListener('click', () => {
                    const isHidden = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isHidden ? 'text' : 'password');
                    toggle.classList.toggle('is-hidden');
                });
            }

            setupPasswordToggle('password', 'togglePass1');
            setupPasswordToggle('confirmPassword', 'togglePass2');

            // Función para mostrar mensajes
            function mostrarMensaje(texto, tipo) {
                alertaDiv.textContent = texto;
                alertaDiv.className = `mensaje-alerta mensaje-${tipo}`;
                alertaDiv.style.display = 'block';
            }

            function ocultarMensaje() {
                alertaDiv.style.display = 'none';
            }

            // Envío del formulario a C#
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                ocultarMensaje();

                const formData = new FormData(form);
                const data = Object.fromEntries(formData);
                const originalText = btnSubmit.textContent;

                // --- NUEVA VALIDACIÓN: Nombre y Apellido ---
                const regexNombres = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+$/;
                
                if (data.firstName.length > 15 || data.lastName.length > 15) {
                    mostrarMensaje("El nombre y apellido no pueden superar los 15 caracteres.", "error");
                    return;
                }

                if (!regexNombres.test(data.firstName) || !regexNombres.test(data.lastName)) {
                    mostrarMensaje("El nombre y apellido solo deben contener letras y espacios.", "error");
                    return;
                }
                // -------------------------------------------

                // Validación manual de contraseñas
                if (data.password !== data.confirmPassword) {
                    mostrarMensaje("Las contraseñas no coinciden.", "error");
                    return;
                }

                // Estado de carga
                btnSubmit.textContent = 'Registrando...';
                btnSubmit.disabled = true;

                try {
                    const response = await fetch("http://localhost:5033/user/Register", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            firstName: data.firstName,
                            lastName: data.lastName,
                            email: data.email,
                            password: data.password
                        })
                    });

                    if (response.ok) {
                        mostrarMensaje("¡Usuario registrado con éxito! Redirigiendo al login...", "exito");
                        form.reset();
                        
                        // Redirigir al login automáticamente después de 1.5 segundos
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 1500);
                    } else {
                        const errorData = await response.json().catch(() => null);
                        const detalle = (errorData && errorData.errors) 
                            ? errorData.errors[0].message 
                            : (errorData && errorData.message) ? errorData.message : "Error al registrar el usuario.";
                        
                        mostrarMensaje(detalle, "error");
                    }
                } catch (error) {
                    mostrarMensaje("No se pudo conectar con el servidor de C#.", "error");
                    console.error("Error:", error);
                } finally {
                    btnSubmit.textContent = originalText;
                    btnSubmit.disabled = false;
                }
            });
        });
    </script>
</body>
</html>