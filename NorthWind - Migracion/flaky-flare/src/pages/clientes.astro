---
// src/pages/clientes.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Directorio de Clientes - Northwind">
  <div class="page-content">
    
    <div class="header-section">
      <h1 class="page-title">Directorio de Clientes</h1>
      
      <div class="header-actions">
        <div class="search-wrapper">
          <div class="filter-group">
            <span class="filter-label">Filtrar por:</span>
            <select id="searchFilterClientes" class="search-select-dark">
              <option value="Todo">Todo</option>
              <option value="Cedula">Cédula</option>
              <option value="Nombre">Nombre</option>
              <option value="Apellido">Apellido</option>
              <option value="Email">Email</option>
              <option value="Telefono">Teléfono</option>
              <option value="Ciudad">Ciudad</option>
              <option value="ConDeuda">Con Deuda</option>
              <option value="SinDeuda">Sin Deuda</option>
            </select>
          </div>
          <div class="search-input-container">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="searchPageClientes" placeholder="Buscar desde el inicio..." autocomplete="off" class="search-input-dark" maxlength="50" />
          </div>
        </div>
        
        <button class="btn-primary" onclick="abrirModalCliente()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Insertar Cliente
        </button>
      </div>
    </div>

    <div class="glass-card table-card">
      <div class="table-responsive">
        <table class="main-table">
          <thead>
            <tr>
              <th class="col-cedula">CÉDULA</th>
              <th class="col-nombre">NOMBRE</th>
              <th class="col-apellido">APELLIDO</th>
              <th class="col-email">CORREO ELECTRÓNICO</th>
              <th class="col-telefono">TELÉFONO</th>
              <th class="col-ciudad">CIUDAD</th>
              <th class="col-balance">BALANCE ACTUAL</th>
              <th class="col-acciones" style="text-align: center;">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="clientesTableBody">
            <tr class="state-row">
              <td colspan="8" style="text-align: center; padding: 3rem; color: #94a3b8;">
                <div class="spinner-small" style="margin: 0 auto 10px auto; border-top-color: var(--color-primary);"></div>
                Cargando datos de clientes...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <div class="table-footer">
        <span id="registrosInfo">Mostrando 0 clientes</span>
        <div class="pagination-controls" id="paginationBtns">
          </div>
      </div>
    </div>
  </div>

  <div id="formClienteModal" class="modal-overlay" style="display: none;">
    <div class="registro-card" style="max-width: 650px;">
      <button class="btn-close-registro" onclick="cerrarModalCliente()">&times;</button>
      
      <div class="registro-header">
        <h2 id="modalTitle">Nuevo Cliente</h2>
        <p id="modalSubtitle">Registra un nuevo cliente en el sistema</p>
      </div>
      
      <div class="registro-body">
        
        <div id="clientePicSection" style="text-align: center; margin-bottom: 2.5rem;">
            <div class="avatar-wrapper mx-auto" style="width: 100px; height: 100px; border-radius: 50%; background: rgba(124, 58, 237, 0.1); border: 3px solid rgba(124, 58, 237, 0.3); margin: 0 auto 1.5rem auto; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">
                <img id="clienteProfileImg" src="" style="display:none; width:100%; height:100%; object-fit:cover;" />
                <div id="clienteProfileFallback" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#a78bfa;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 48px; height: 48px;">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
            </div>
            
            <div style="display: flex; gap: 1rem; justify-content: center; align-items: center; max-width: 380px; margin: 0 auto;">
                <input type="file" id="clienteFileUpload" accept="image/jpeg, image/png, image/webp" style="display: none;" />
                
                <button type="button" class="btn-perfil-purple-large" onclick="document.getElementById('clienteFileUpload').click()" style="flex: 1; padding: 0.6rem 1rem; font-size: 0.9rem;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M12 10l0 4"></path><path d="M10 12l4 0"></path></svg>
                    Cambiar Foto
                </button>
                
                <button type="button" class="btn-perfil-red-outline-large" id="btnClienteDeletePic" style="display:none; flex: 1; padding: 0.6rem 1rem; font-size: 0.9rem;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7l16 0"></path><path d="M10 11l0 6"></path><path d="M14 11l0 6"></path><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"></path><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"></path></svg>
                    Eliminar Foto
                </button>
            </div>
            <p style="color: #94a3b8; font-size: 0.8rem; margin-top: 0.75rem; font-weight: 500;">JPG, PNG. Máx 5MB.</p>
        </div>

        <form id="clienteForm">
          <input type="hidden" id="formMode" value="create">
          <input type="hidden" id="formInternalId">
          
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                    <label for="formCedula" style="margin-bottom: 0;">Cédula</label>
                    <span id="provinciaLabel" style="font-size: 0.8rem; font-weight: 600; color: var(--color-success); display: none;"></span>
                </div>
                <input type="text" id="formCedula" required maxlength="10" placeholder="Ej: 1723456789" class="reg-input" oninput="this.setCustomValidity(''); this.value = this.value.replace(/[^0-9]/g, ''); if(window.validarCedulaEcuatoriana) window.validarCedulaEcuatoriana(this);">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formFirstName">Nombre</label>
                <input type="text" id="formFirstName" required maxlength="15" placeholder="Nombre" class="reg-input" 
                  onkeydown="if(event.key === ' ') { event.preventDefault(); return false; }" 
                  oninput="this.setCustomValidity(''); this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ]/g, ''); if(this.value.length > 0) this.value = this.value.charAt(0).toUpperCase() + this.value.slice(1).toLowerCase();">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formLastName">Apellido</label>
                <input type="text" id="formLastName" required maxlength="15" placeholder="Apellidos" class="reg-input" 
                  onkeydown="if(event.key === ' ') { event.preventDefault(); return false; }" 
                  oninput="this.setCustomValidity(''); this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ]/g, ''); if(this.value.length > 0) this.value = this.value.charAt(0).toUpperCase() + this.value.slice(1).toLowerCase();">
              </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formEmail">Correo Electrónico</label>
                <input type="email" id="formEmail" maxlength="100" placeholder="cliente@correo.com" class="reg-input" style="color: #93c5fd;" onkeydown="if(event.key === ' ') { event.preventDefault(); return false; }" oninput="this.setCustomValidity(''); this.value = this.value.replace(/\s/g, '');">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formPhone">Teléfono</label>
                <input type="text" id="formPhone" required maxlength="10" placeholder="Ej: 0999123456" class="reg-input" oninput="this.setCustomValidity(''); this.value = this.value.replace(/[^0-9]/g, '');">
              </div>
          </div>

          <div id="passwordSection" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formPassword">Contraseña</label>
                <div class="password-wrapper">
                    <input type="password" id="formPassword" placeholder="••••••••" class="reg-input" oninput="this.setCustomValidity('');">
                    <button type="button" class="btn-eye" onclick="togglePassword('formPassword')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formConfirmPassword">Confirmar Contraseña</label>
                <div class="password-wrapper">
                    <input type="password" id="formConfirmPassword" placeholder="••••••••" class="reg-input" oninput="this.setCustomValidity('');">
                    <button type="button" class="btn-eye" onclick="togglePassword('formConfirmPassword')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
              </div>
          </div>

          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formCity">Ciudad</label>
                <input type="text" id="formCity" maxlength="60" placeholder="Ej: Ambato" class="reg-input" oninput="this.setCustomValidity('');">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="formBalance">Balance Actual</label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-weight: bold;">$</span>
                    <input type="number" id="formBalance" step="0.01" min="0" max="9999.99" placeholder="0.00" class="reg-input" style="padding-left: 28px;" onkeydown="if(['e', 'E', '+', '-'].includes(event.key)) event.preventDefault();" oninput="this.setCustomValidity(''); if(Number(this.value) > 9999.99) this.value = this.value.toString().slice(0, -1);">
                </div>
              </div>
          </div>

          <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
            <button type="button" class="btn-modal btn-cancel" onclick="cerrarModalCliente()" style="flex: 1; margin: 0; padding: 12px; border-radius: 0.5rem;">
              Cancelar
            </button>
            <button type="submit" class="btn-registro-submit" id="btnGuardarForm" style="flex: 1; margin: 0;">
              <span id="btnGuardarText">Guardar Cliente</span>
              <div id="btnSpinner" class="spinner-small" style="display:none; margin: 0 auto;"></div>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modales de Confirmación y Eliminación -->
  <div id="deleteConfirmModal" class="modal-overlay" style="display: none; z-index: 2000;">
    <div class="modal-card">
      <div class="modal-icon-container" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="modal-icon-svg" style="color: #ef4444;">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <h2 class="modal-title">¿Eliminar Cliente?</h2>
      <p class="modal-text">
        Estás a punto de eliminar permanentemente al cliente con cédula <strong id="deleteClienteCedula" style="color: white;"></strong>. Esta acción no se puede deshacer.
      </p>
      <div class="modal-actions">
        <button class="btn-modal btn-cancel" onclick="cerrarModalDelete()">Cancelar</button>
        <button class="btn-modal btn-confirm" id="btnConfirmDelete" style="background: #ef4444;">
          <span id="btnDeleteText">Sí, eliminar</span>
          <div id="btnDeleteSpinner" class="spinner-small" style="display:none;"></div>
        </button>
      </div>
    </div>
  </div>

  <div id="confirmDeletePhotoModal" class="modal-overlay" style="display: none; z-index: 2000;">
    <div class="modal-card">
      <div class="modal-icon-container" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="modal-icon-svg" style="color: #ef4444;">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <h2 class="modal-title">¿Eliminar Foto?</h2>
      <p class="modal-text">La foto se marcará para eliminación. Esta acción se aplicará al hacer clic en <strong>Guardar/Actualizar</strong>.</p>
      <div class="modal-actions">
        <button class="btn-modal btn-cancel" onclick="cerrarConfirmDeletePhoto()">Cancelar</button>
        <button class="btn-modal btn-confirm" id="btnConfirmDeletePhotoConfirm" style="background: #ef4444;">
          <span id="btnDeletePhotoText">Sí, eliminar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: DESCARTAR CAMBIOS -->
  <div id="unsavedChangesModal" class="modal-overlay" style="display: none; z-index: 3000;">
    <div class="modal-card">
      <div class="modal-icon-container" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="modal-icon-svg" style="color: #ef4444;">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
      </div>
      <h2 class="modal-title">¿Descartar cambios?</h2>
      <p class="modal-text">Tienes datos sin guardar. Si cierras ahora, <strong>todos tus cambios se perderán</strong>.</p>
      <div class="modal-actions">
        <button class="btn-modal btn-cancel" onclick="cerrarUnsavedModal()">No, seguir editando</button>
        <button class="btn-modal btn-confirm" style="background: #ef4444;" onclick="confirmDiscardChanges()">Sí, descartar</button>
      </div>
    </div>
  </div>

  <div id="toastNotif" class="toast-notif" style="display: none;">
    <span id="toastMsg">Operación exitosa</span>
  </div>

</MainLayout>

<style is:global>
  :root {
    --bg-card-dark: rgba(255, 255, 255, 0.03);
    --bg-input-dark: rgba(0, 0, 0, 0.3);
    --border-dark: rgba(255, 255, 255, 0.1);
    --text-muted: #94a3b8;
    --text-white: #ffffff;
    --color-id: #a78bfa; 
    --color-balance: #86efac; 
    --color-primary: #7c3aed; 
    --color-primary-hover: #6d28d9;
    --color-danger: #ef4444; 
    --color-danger-hover: #dc2626;
    --color-warning: #eab308; 
    --color-success: #10b981;
    --bg-registro: #1f163f; 
    --bg-input-reg: #160f2e;
  }

  .page-content { padding: 0; width: 100%; box-sizing: border-box; }

  .glass-card { background: var(--bg-card-dark); backdrop-filter: blur(25px); border-radius: 1.25rem; border: 1px solid var(--border-dark); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
  .search-wrapper { display: flex; align-items: center; gap: 12px; }
  .filter-group { display: flex; align-items: center; gap: 8px; }
  .filter-label { color: var(--text-muted); font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .search-input-container { position: relative; display: flex; align-items: center; }
  .search-icon { position: absolute; left: 14px; width: 16px; height: 16px; color: var(--text-muted); z-index: 2; }
  
  .search-select-dark { padding: 10px 16px; border-radius: 0.75rem; border: 1px solid var(--border-dark); background-color: #1a103c; color: white; font-size: 0.95rem; outline: none; cursor: pointer; transition: border-color 0.3s ease; }
  .search-select-dark:focus { border-color: var(--color-primary); background-color: #2d1b63; }
  .search-select-dark option { background-color: #1a103c; color: white; }

  .search-input-dark { padding: 10px 16px 10px 40px !important; width: 300px; border-radius: 0.75rem !important; border: 1px solid var(--border-dark) !important; background-color: #1a103c !important; color: white !important; font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.3s ease; }
  .search-input-dark::placeholder { color: #64748b !important; }
  .search-input-dark:focus { border-color: var(--color-primary) !important; background-color: #2d1b63 !important; }

  input:-webkit-autofill { -webkit-box-shadow: 0 0 0 30px #1a103c inset !important; -webkit-text-fill-color: white !important; }

  .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--color-primary); color: white; border: none; padding: 10px 20px; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; height: fit-content; white-space: nowrap; }
  .btn-primary:hover { background: var(--color-primary-hover); transform: translateY(-1px); }
  .btn-primary:disabled { opacity: 0.7; cursor: not-allowed; }
  .btn-primary svg { width: 18px; height: 18px; }

  .btn-danger { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--color-danger); color: white; border: none; padding: 10px 20px; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .btn-danger:hover { background: var(--color-danger-hover); transform: translateY(-1px); }
  .btn-danger:disabled { opacity: 0.7; cursor: not-allowed; }

  .btn-secondary { background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--border-dark); padding: 10px 20px; border-radius: 0.75rem; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }

  .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
  .page-title { color: var(--text-white); font-size: 1.5rem; font-weight: 600; margin: 0; }
  .header-actions { display: flex; gap: 16px; align-items: center; }

  .table-card { display: flex; flex-direction: column; overflow: hidden; }
  .table-responsive { overflow-x: auto; max-height: calc(100vh - 250px); }
  .main-table { width: 100%; border-collapse: collapse; text-align: left; }
  .main-table thead th { background: rgba(255, 255, 255, 0.03); color: var(--text-muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; padding: 1.2rem 1.5rem; position: sticky; top: 0; z-index: 1; }
  .main-table tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.03); transition: background-color 0.15s ease; }
  .main-table tbody tr:hover { background: rgba(124, 58, 237, 0.15); }
  .main-table td { padding: 1.2rem 1.5rem; font-size: 0.95rem; color: #cbd5e1; vertical-align: middle; }

  .table-avatar-container { display: flex; align-items: center; gap: 12px; }
  .table-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(124, 58, 237, 0.3); }
  .table-avatar-fallback { width: 36px; height: 36px; border-radius: 50%; background: rgba(124, 58, 237, 0.2); color: #a78bfa; display: flex; align-items: center; justify-content: center; border: 2px solid rgba(124, 58, 237, 0.3); }

  .action-buttons { display: flex; gap: 8px; justify-content: center; }
  .btn-icon { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); cursor: pointer; padding: 8px; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .btn-edit { color: #cbd5e1; }
  .btn-edit:hover { background: rgba(234, 179, 8, 0.2); color: var(--color-warning); border-color: var(--color-warning); }
  .btn-delete { color: #cbd5e1; }
  .btn-delete:hover { background: rgba(239, 68, 68, 0.2); color: var(--color-danger); border-color: var(--color-danger); }
  .btn-icon svg { width: 16px; height: 16px; }

  .table-footer { padding: 1.2rem 1.5rem; background: rgba(0, 0, 0, 0.2); border-top: 1px solid var(--border-dark); display: flex; justify-content: space-between; align-items: center; }
  #registrosInfo { color: var(--text-muted); font-size: 0.85rem; }
  .pagination-controls { display: flex; gap: 6px; }
  .page-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white; padding: 0.3rem 0.8rem; border-radius: 0.4rem; cursor: pointer; font-size: 0.9rem; transition: all 0.2s;}
  .page-btn:hover:not(:disabled) { background: rgba(255, 255, 255, 0.1); }
  .page-btn.active { background: var(--color-primary); border-color: var(--color-primary); }

  .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; animation: fadeIn 0.2s ease-out; }
  
  .registro-card { background: var(--bg-registro); border-radius: 1.25rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); width: 90%; max-width: 500px; padding: 2.5rem; position: relative; animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
