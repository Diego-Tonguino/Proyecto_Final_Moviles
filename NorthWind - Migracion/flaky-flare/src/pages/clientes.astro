<script is:inline>
  window.togglePassword = function(fieldId) {
    const field = document.getElementById(fieldId);
    if (field) {
        field.type = field.type === 'password' ? 'text' : 'password';
    }
  };
</script>

<script>
  const API_URL = 'https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/api/customers';
  
  interface Cliente {
    id?: string; Id?: string; customerId?: string; CustomerId?: string;
    cedula?: string; Cedula?: string; 
    firstName?: string; FirstName?: string; 
    lastName?: string; LastName?: string; 
    companyName?: string; CompanyName?: string; 
    email?: string; Email?: string;
    phone?: string; Phone?: string;
    city?: string; City?: string;
    country?: string; Country?: string;
    currentBalance?: number; CurrentBalance?: number;
  }

  let todosLosClientes: Cliente[] = [];
  let clienteIdAEliminar: string | null = null;
  let paginaActual = 1;
  const itemsPorPagina = 10;
  let clientesFiltrados: Cliente[] = [];

  let fileToUpload: File | null = null;
  let deletePicFlag: boolean = false;
  
  // Control de cambios sin guardar
  let isFormDirty = false;

  const isAdmin = (localStorage.getItem('northwind_user_role') || '').toLowerCase().includes('admin');
  const tokenLocal = localStorage.getItem('northwind_token') || '';

  function getAuthHeaders() {
    return {
      'Content-Type': 'application/json',
      'Authorization': tokenLocal ? `Bearer ${tokenLocal}` : ''
    };
  }

  const tableBody = document.getElementById('clientesTableBody');
  const searchInput = document.getElementById('searchPageClientes') as HTMLInputElement;
  const searchFilter = document.getElementById('searchFilterClientes') as HTMLSelectElement;
  const registrosInfo = document.getElementById('registrosInfo');
  const paginationBtns = document.getElementById('paginationBtns');
  const formElement = document.getElementById('clienteForm') as HTMLFormElement;
  
  if (sessionStorage.getItem('cliente_photo_changed') === 'true') {
      setTimeout(() => showToast("Cliente y foto actualizados exitosamente"), 100);
      sessionStorage.removeItem('cliente_photo_changed');
  }

  // Detectar cambios en los inputs para activar el estado "sucio"
  if (formElement) {
      const formInputs = formElement.querySelectorAll('input');
      formInputs.forEach(input => {
          input.addEventListener('input', () => {
              isFormDirty = true;
          });
      });
  }

  const btnFileUpload = document.getElementById('clienteFileUpload');
  if (btnFileUpload) {
    btnFileUpload.onchange = (e: any) => {
        const file = e.target.files[0];
        if (!file) return;
        
        fileToUpload = file;
        deletePicFlag = false; 
        isFormDirty = true; // Activar cambios sin guardar
        
        const url = URL.createObjectURL(file);
        const img = document.getElementById('clienteProfileImg');
        const fallback = document.getElementById('clienteProfileFallback');
        const btnDelete = document.getElementById('btnClienteDeletePic');
        
        if(img && fallback && btnDelete) {
            img.setAttribute('src', url);
            img.style.display = 'block';
            fallback.style.display = 'none';
            btnDelete.style.display = 'flex';
        }
        
        showToast("Foto cargada, dale en guardar/actualizar para confirmar los cambios");
        e.target.value = ''; 
    };
  }

  const btnClienteDelete = document.getElementById('btnClienteDeletePic');
  if (btnClienteDelete) {
    btnClienteDelete.onclick = () => {
        const modalConfirm = document.getElementById('confirmDeletePhotoModal') as HTMLElement;
        if(modalConfirm) modalConfirm.style.display = 'flex';
    };
  }

  const btnConfirmDeletePhoto = document.getElementById('btnConfirmDeletePhotoConfirm');
  if (btnConfirmDeletePhoto) {
    btnConfirmDeletePhoto.onclick = () => {
        deletePicFlag = true;
        fileToUpload = null;
        isFormDirty = true; // Activar cambios sin guardar
        
        const fileInput = document.getElementById('clienteFileUpload') as HTMLInputElement;
        if(fileInput) fileInput.value = '';
        
        const img = document.getElementById('clienteProfileImg');
        const fallback = document.getElementById('clienteProfileFallback');
        const btnDelete = document.getElementById('btnClienteDeletePic');
        
        if(img && fallback && btnDelete) {
            img.style.display = 'none';
            fallback.style.display = 'flex';
            btnDelete.style.display = 'none';
        }
        
        showToast("Foto eliminada, dale en guardar/actualizar para confirmar los cambios");
        (window as any).cerrarConfirmDeletePhoto();
    };
  }

  (window as any).cerrarConfirmDeletePhoto = () => {
      const modalConfirm = document.getElementById('confirmDeletePhotoModal') as HTMLElement;
      if(modalConfirm) modalConfirm.style.display = 'none';
  };

  async function cargarDatos() {
    try {
      const respuesta = await fetch(API_URL, { headers: getAuthHeaders() });
      if (!respuesta.ok) throw new Error('Error al conectar');
      const data = await respuesta.json();
      todosLosClientes = data;
      clientesFiltrados = data;
      renderizarTabla();
    } catch (error) {
      if (tableBody) tableBody.innerHTML = `<tr><td colspan="${isAdmin ? '8' : '7'}" style="text-align:center; padding:3rem; color:#ef4444;">Error al conectar con la API de clientes</td></tr>`;
    }
  }

  function renderizarTabla() {
    if (!tableBody) return;
    const inicio = (paginaActual - 1) * itemsPorPagina;
    const fin = inicio + itemsPorPagina;
    const clientesPagina = clientesFiltrados.slice(inicio, fin);

    if (registrosInfo) registrosInfo.textContent = `Mostrando ${clientesPagina.length} de ${clientesFiltrados.length} clientes (Pág ${paginaActual})`;

    if (clientesPagina.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="${isAdmin ? '8' : '7'}" style="text-align:center; padding:3rem; color:#94a3b8;">No se encontraron clientes</td></tr>`;
      renderizarControlesPaginacion(0);
      return;
    }

    tableBody.innerHTML = clientesPagina.map(c => {
      const internalId = c.id || c.Id || c.customerId || c.CustomerId || '';
      const cedula = c.cedula || c.Cedula || 'N/A';
      const firstName = c.firstName || c.FirstName || '';
      const lastName = c.lastName || c.LastName || '';
      const company = c.companyName || c.CompanyName || '';
      const email = c.email || c.Email || 'No registrado';
      const phone = c.phone || c.Phone || 'Sin teléfono';
      const city = c.city || c.City || 'Sin ciudad';
      const country = c.country || c.Country || '';
      const balance = Number(c.currentBalance ?? c.CurrentBalance ?? 0);
      const balanceColor = balance > 0 ? 'var(--color-danger)' : 'var(--color-balance)';

      const timestamp = new Date().getTime();
      const avatarUrl = `${API_URL}/${internalId}/profile-picture?t=${timestamp}`;
      const tableSvgIcon = `
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 20px; height: 20px;">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
          </svg>
      `;

      const clienteJson = encodeURIComponent(JSON.stringify({ 
          id: internalId, cedula, firstName, lastName, companyName: company, email, phone, city, country, balance 
      })).replace(/'/g, "%27");

      const accionesHTML = isAdmin ? `
        <td>
          <div class="action-buttons">
            <button class="btn-icon btn-edit" title="Editar" onclick="prepararEdicion('${clienteJson}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </button>
            <button class="btn-icon btn-delete" title="Eliminar" onclick="abrirModalDelete('${internalId}', '${cedula}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            </button>
          </div>
        </td>` : '';

      return `
        <tr>
          <td><span style="color: var(--color-id); font-weight: 700; letter-spacing: 0.5px;">${cedula}</span></td>
          <td>
            <div class="table-avatar-container">
                <img src="${avatarUrl}" class="table-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="table-avatar-fallback" style="display:none;">${tableSvgIcon}</div>
                <span style="font-weight: 600; color: white;">${firstName}</span>
            </div>
          </td>
          <td style="font-weight: 600; color: white;">${lastName}</td>
          <td style="color: #93c5fd;">${email}</td>
          <td style="color: #cbd5e1;">${phone}</td>
          <td style="color: #cbd5e1; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${city}">${city}</td>
          <td style="color: ${balanceColor}; font-weight: 600;">$${balance.toFixed(2)}</td>
          ${accionesHTML}
        </tr>
      `;
    }).join('');
    renderizarControlesPaginacion(Math.ceil(clientesFiltrados.length / itemsPorPagina));
  }

  function renderizarControlesPaginacion(totalPaginas: number) {
    if (!paginationBtns) return;
    let html = `<button class="page-btn" id="btnPrevPage" ${paginaActual === 1 || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&laquo;</button>`;
    for (let i = 1; i <= totalPaginas; i++) {
      html += `<button class="page-btn ${i === paginaActual ? 'active' : ''}" data-page="${i}">${i}</button>`;
    }
    html += `<button class="page-btn" id="btnNextPage" ${paginaActual === totalPaginas || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&raquo;</button>`;
    paginationBtns.innerHTML = html;

    document.getElementById('btnPrevPage')?.addEventListener('click', () => { if (paginaActual > 1) { paginaActual--; renderizarTabla(); }});
    document.getElementById('btnNextPage')?.addEventListener('click', () => { if (paginaActual < totalPaginas) { paginaActual++; renderizarTabla(); }});
    paginationBtns.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', (e) => { paginaActual = parseInt((e.target as HTMLElement).getAttribute('data-page') || '1'); renderizarTabla(); });
    });
  }

  function aplicarFiltros() {
    const term = searchInput?.value.toLowerCase().trim() || "";
    const filterType = searchFilter?.value || "Todo";

    clientesFiltrados = todosLosClientes.filter(c => {
      const cedulaStr = String(c.cedula || c.Cedula || "").toLowerCase();
      const firstName = String(c.firstName || c.FirstName || "").toLowerCase();
      const lastName = String(c.lastName || c.LastName || "").toLowerCase();
      const email = String(c.email || c.Email || "").toLowerCase();
      const phone = String(c.phone || c.Phone || "").toLowerCase();
      const city = String(c.city || c.City || "").toLowerCase();
      const balance = Number(c.currentBalance ?? c.CurrentBalance ?? 0);

      let matchText = false;
      
      // === REGLA ESTRICTA DE BÚSQUEDA DESDE LA PRIMERA LETRA/NÚMERO ===
      if (filterType === "Cedula") {
        matchText = cedulaStr.startsWith(term);
      } else if (filterType === "Nombre") {
        matchText = firstName.startsWith(term);
      } else if (filterType === "Apellido") {
        matchText = lastName.startsWith(term);
      } else if (filterType === "Email") {
        matchText = email.startsWith(term);
      } else if (filterType === "Telefono") {
        matchText = phone.startsWith(term);
      } else if (filterType === "Ciudad") {
        matchText = city.startsWith(term);
      } else {
        matchText = cedulaStr.startsWith(term) || 
                    firstName.startsWith(term) || 
                    lastName.startsWith(term) || 
                    email.startsWith(term) || 
                    phone.startsWith(term) || 
                    city.startsWith(term);
      }

      if (filterType === "ConDeuda") {
        return matchText && balance > 0;
      } else if (filterType === "SinDeuda") {
        return matchText && balance === 0;
      }

      return matchText;
    });
    
    paginaActual = 1;
    renderizarTabla();
  }

  searchInput?.addEventListener('input', aplicarFiltros);
  searchFilter?.addEventListener('change', aplicarFiltros);

  (window as any).validarCedulaEcuatoriana = (input: HTMLInputElement) => {
    const cedula = input.value;
    const provLabel = document.getElementById('provinciaLabel');
    if (!provLabel) return;
    
    input.setCustomValidity('');
    
    if (cedula.length < 2) {
        provLabel.style.display = 'none';
        return;
    }

    const provCode = parseInt(cedula.substring(0, 2), 10);
    const provincias: Record<number, string> = {
        1: 'Azuay', 2: 'Bolívar', 3: 'Cañar', 4: 'Carchi', 5: 'Cotopaxi',
        6: 'Chimborazo', 7: 'El Oro', 8: 'Esmeraldas', 9: 'Guayas', 10: 'Imbabura',
        11: 'Loja', 12: 'Los Ríos', 13: 'Manabí', 14: 'Morona Santiago', 15: 'Napo',
        16: 'Pastaza', 17: 'Pichincha', 18: 'Tungurahua', 19: 'Zamora Chinchipe', 20: 'Galápagos',
        21: 'Sucumbíos', 22: 'Orellana', 23: 'Santo Domingo', 24: 'Santa Elena', 30: 'Exterior'
    };

    if (provCode < 1 || (provCode > 24 && provCode !== 30)) {
        if (cedula.length === 10) input.setCustomValidity('Provincia inválida en la cédula.');
        provLabel.style.display = 'none';
        return;
    }

    provLabel.textContent = 'Provincia: ' + provincias[provCode];
    provLabel.style.display = 'inline';

    if (cedula.length === 10) {
        const tercerDigito = parseInt(cedula.substring(2, 3), 10);
        if (tercerDigito >= 6) {
            input.setCustomValidity('Cédula inválida. Tercer dígito debe ser menor a 6.');
            return;
        }

        let suma = 0;
        const coeficientes = [2, 1, 2, 1, 2, 1, 2, 1, 2];
        for (let i = 0; i < 9; i++) {
            let valor = parseInt(cedula.charAt(i), 10) * coeficientes[i];
            if (valor >= 10) valor -= 9;
            suma += valor;
        }
        
        const decenaSuperior = Math.ceil(suma / 10) * 10;
        let digitoVerificador = decenaSuperior - suma;
        if (digitoVerificador === 10) digitoVerificador = 0;
        
        if (digitoVerificador !== parseInt(cedula.charAt(9), 10)) {
            input.setCustomValidity('Cédula ecuatoriana inválida.');
            return;
        }
    }
  };

  (window as any).abrirModalCliente = () => {
    const modal = document.getElementById('formClienteModal') as HTMLElement;
    if (modal) {
      isFormDirty = false; // Resetear al abrir
      document.getElementById('formMode')!.value = 'create';
      
      const provLabel = document.getElementById('provinciaLabel');
      if (provLabel) provLabel.style.display = 'none';

      
      (document.getElementById('formInternalId') as HTMLInputElement).value = '';
      
      // Asegurarse de que esté desbloqueada para un nuevo cliente
      const inputCedula = document.getElementById('formCedula') as HTMLInputElement;
      inputCedula.value = '';
      inputCedula.readOnly = false;
      inputCedula.style.opacity = '1';
      inputCedula.style.cursor = 'text';
      
      (document.getElementById('formFirstName') as HTMLInputElement).value = '';
      (document.getElementById('formLastName') as HTMLInputElement).value = '';
      (document.getElementById('formEmail') as HTMLInputElement).value = '';
      (document.getElementById('formPhone') as HTMLInputElement).value = '';
      (document.getElementById('formCity') as HTMLInputElement).value = '';
      (document.getElementById('formBalance') as HTMLInputElement).value = '';
      
      const pwdSection = document.getElementById('passwordSection');
      if (pwdSection) pwdSection.style.display = 'grid';
      
      const pwdInput = document.getElementById('formPassword') as HTMLInputElement;
      const pwdConfirmInput = document.getElementById('formConfirmPassword') as HTMLInputElement;
      
      pwdInput.value = '';
      pwdConfirmInput.value = '';
      pwdInput.required = true;
      pwdConfirmInput.required = true;
      pwdInput.placeholder = '••••••••';
      pwdConfirmInput.placeholder = '••••••••';
      
      document.getElementById('modalTitle')!.textContent = 'Nuevo Cliente';
      document.getElementById('modalSubtitle')!.textContent = 'Registra un nuevo cliente en el sistema';
      document.getElementById('btnGuardarText')!.textContent = 'Guardar Cliente';
      
      fileToUpload = null;
      deletePicFlag = false;
      const fileInput = document.getElementById('clienteFileUpload') as HTMLInputElement;
      if(fileInput) fileInput.value = '';
      
      document.getElementById('clienteProfileImg')!.style.display = 'none';
      document.getElementById('clienteProfileFallback')!.style.display = 'flex';
      document.getElementById('btnClienteDeletePic')!.style.display = 'none';
      
      modal.style.display = 'flex';
    }
  };

  (window as any).cerrarModalCliente = () => {
    if (isFormDirty) {
        // Mostrar advertencia si el formulario está sucio
        const modal = document.getElementById('unsavedChangesModal') as HTMLElement;
        if (modal) modal.style.display = 'flex';
    } else {
        // Cerrar directamente
        (window as any).forceCloseClienteModal();
    }
  };

  (window as any).forceCloseClienteModal = () => {
    const modal = document.getElementById('formClienteModal') as HTMLElement;
    if (modal) modal.style.display = 'none';
    isFormDirty = false; // Resetear
  };

  (window as any).cerrarUnsavedModal = () => {
    const modal = document.getElementById('unsavedChangesModal') as HTMLElement;
    if (modal) modal.style.display = 'none';
  };

  (window as any).confirmDiscardChanges = () => {
    const unsavedModal = document.getElementById('unsavedChangesModal') as HTMLElement;
    if (unsavedModal) unsavedModal.style.display = 'none';
    (window as any).forceCloseClienteModal();
  };

  (window as any).prepararEdicion = (dataEncoded: string) => {
    const data = JSON.parse(decodeURIComponent(dataEncoded));
    const modal = document.getElementById('formClienteModal') as HTMLElement;
    if (modal) {
      isFormDirty = false; // Resetear al abrir
      document.getElementById('formMode')!.value = 'edit';
      
      (document.getElementById('formInternalId') as HTMLInputElement).value = data.id || '';
      
      const inputCedula = document.getElementById('formCedula') as HTMLInputElement;
      inputCedula.value = data.cedula === 'N/A' ? '' : data.cedula;
      // BLOQUEAR CÉDULA AL EDITAR
      inputCedula.readOnly = true;
      inputCedula.style.opacity = '0.6';
      inputCedula.style.cursor = 'not-allowed';
      if ((window as any).validarCedulaEcuatoriana) (window as any).validarCedulaEcuatoriana(inputCedula);

      (document.getElementById('formFirstName') as HTMLInputElement).value = data.firstName || '';
      (document.getElementById('formLastName') as HTMLInputElement).value = data.lastName || '';
      (document.getElementById('formEmail') as HTMLInputElement).value = data.email === 'No registrado' ? '' : data.email;
      (document.getElementById('formPhone') as HTMLInputElement).value = data.phone === 'Sin teléfono' ? '' : data.phone;
      (document.getElementById('formCity') as HTMLInputElement).value = data.city === 'Sin ciudad' ? '' : data.city;
      (document.getElementById('formBalance') as HTMLInputElement).value = data.balance || 0;
      
      const pwdSection = document.getElementById('passwordSection');
      if (pwdSection) pwdSection.style.display = 'grid';
      
      const pwdInput = document.getElementById('formPassword') as HTMLInputElement;
      const pwdConfirmInput = document.getElementById('formConfirmPassword') as HTMLInputElement;
      
      pwdInput.value = '';
      pwdConfirmInput.value = '';
      pwdInput.required = false;
      pwdConfirmInput.required = false;
      pwdInput.placeholder = 'Nueva (opcional)';
      pwdConfirmInput.placeholder = 'Confirmar nueva';
      
      document.getElementById('modalTitle')!.textContent = 'Editar Cliente';
      document.getElementById('modalSubtitle')!.textContent = 'Actualiza los datos del cliente';
      document.getElementById('btnGuardarText')!.textContent = 'Actualizar Cliente';
      
      fileToUpload = null;
      deletePicFlag = false;
      const fileInput = document.getElementById('clienteFileUpload') as HTMLInputElement;
      if(fileInput) fileInput.value = '';
      
      const img = document.getElementById('clienteProfileImg') as HTMLImageElement;
      const fallback = document.getElementById('clienteProfileFallback');
      const btnDelete = document.getElementById('btnClienteDeletePic');
      
      if(img && fallback && btnDelete) {
          const timestamp = new Date().getTime();
          img.src = `${API_URL}/${data.id}/profile-picture?t=${timestamp}`;
          
          img.onload = () => { 
              img.style.display = 'block'; 
              fallback.style.display = 'none'; 
              btnDelete.style.display = 'flex'; 
          };
          
          img.onerror = () => { 
              img.style.display = 'none'; 
              fallback.style.display = 'flex'; 
              btnDelete.style.display = 'none'; 
          };
      }
      
      modal.style.display = 'flex';
    }
  };

  (window as any).abrirModalDelete = (id: string, cedula: string) => {
    clienteIdAEliminar = id;
    const deleteModal = document.getElementById('deleteConfirmModal') as HTMLElement;
    const deleteClienteCedula = document.getElementById('deleteClienteCedula');
    if (deleteClienteCedula) deleteClienteCedula.textContent = cedula || 'Desconocida';
    if (deleteModal) deleteModal.style.display = 'flex';
  };

  (window as any).cerrarModalDelete = () => {
    const deleteModal = document.getElementById('deleteConfirmModal') as HTMLElement;
    if (deleteModal) deleteModal.style.display = 'none';
    clienteIdAEliminar = null;
  };

  // ==========================================
  // EVENTO SUBMIT CON VALIDACIÓN VÍA JAVASCRIPT Y BURBUJAS NATIVAS
  // ==========================================
  formElement?.addEventListener('submit', async (e) => {
    e.preventDefault(); 
    
    const mode = (document.getElementById('formMode') as HTMLInputElement).value;
    const internalId = (document.getElementById('formInternalId') as HTMLInputElement).value;
    const cedula = (document.getElementById('formCedula') as HTMLInputElement).value.trim();
    const firstName = (document.getElementById('formFirstName') as HTMLInputElement).value.trim();
    const lastName = (document.getElementById('formLastName') as HTMLInputElement).value.trim();
    const email = (document.getElementById('formEmail') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('formPhone') as HTMLInputElement).value.trim();
    const city = (document.getElementById('formCity') as HTMLInputElement).value.trim();
    
    const inputCedula = document.getElementById('formCedula') as HTMLInputElement;
    const inputFirstName = document.getElementById('formFirstName') as HTMLInputElement;
    const inputLastName = document.getElementById('formLastName') as HTMLInputElement;
    const inputEmail = document.getElementById('formEmail') as HTMLInputElement;
    const inputPhone = document.getElementById('formPhone') as HTMLInputElement;
    
    const inputPassword = document.getElementById('formPassword') as HTMLInputElement;
    const inputConfirm = document.getElementById('formConfirmPassword') as HTMLInputElement;
    const password = inputPassword.value;
    const confirmPassword = inputConfirm.value;
    const balance = parseFloat((document.getElementById('formBalance') as HTMLInputElement).value) || 0;

    // VALIDACIONES USANDO GLOBOS NATIVOS
    const regexCedula = /^\d{10}$/;
    if (!regexCedula.test(cedula)) {
      inputCedula.setCustomValidity('La cédula debe tener exactamente 10 dígitos numéricos.');
      inputCedula.reportValidity();
      return;
    }
    if ((window as any).validarCedulaEcuatoriana) {
      (window as any).validarCedulaEcuatoriana(inputCedula);
      if (!inputCedula.checkValidity()) {
        inputCedula.reportValidity();
        return;
      }
    }

    const regexNombres = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ]+$/;
    if (!regexNombres.test(firstName)) {
      inputFirstName.setCustomValidity('Solo debe contener letras (sin espacios).');
      inputFirstName.reportValidity();
      return;
    }
    if (!regexNombres.test(lastName)) {
      inputLastName.setCustomValidity('Solo debe contener letras (sin espacios).');
      inputLastName.reportValidity();
      return;
    }

    if (email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        inputEmail.setCustomValidity('El correo electrónico debe tener un formato válido.');
        inputEmail.reportValidity();
        return;
      }
    }

    const regexPhone = /^09\d{8}$/;
    if (!regexPhone.test(phone)) {
      inputPhone.setCustomValidity('El teléfono debe tener exactamente 10 dígitos y empezar con "09".');
      inputPhone.reportValidity();
      return;
    }

    const regexSpecialChar = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+/;
    if (mode === 'create') {
        if (password.length > 0 && password.length < 6) {
            inputPassword.setCustomValidity('La contraseña debe tener al menos 6 caracteres.');
            inputPassword.reportValidity();
            return;
        }
        if (password.length > 0 && !regexSpecialChar.test(password)) {
            inputPassword.setCustomValidity('La contraseña debe incluir al menos un carácter especial.');
            inputPassword.reportValidity();
            return;
        }
        if (password !== confirmPassword) {
            inputConfirm.setCustomValidity('Las contraseñas no coinciden.');
            inputConfirm.reportValidity();
            return;
        }
    } else if (password || confirmPassword) {
        if (password.length > 0 && password.length < 6) {
            inputPassword.setCustomValidity('La contraseña debe tener al menos 6 caracteres.');
            inputPassword.reportValidity();
            return;
        }
        if (password.length > 0 && !regexSpecialChar.test(password)) {
            inputPassword.setCustomValidity('La contraseña debe incluir al menos un carácter especial.');
            inputPassword.reportValidity();
            return;
        }
        if (password !== confirmPassword) {
            inputConfirm.setCustomValidity('Las contraseñas no coinciden.');
            inputConfirm.reportValidity();
            return;
        }
    }

    const btnGuardar = formElement.querySelector('#btnGuardarForm') as HTMLElement;
    const btnText = document.getElementById('btnGuardarText');
    const btnSpinner = document.getElementById('btnSpinner');

    if (btnGuardar) (btnGuardar as HTMLButtonElement).disabled = true;
    if (btnSpinner) btnSpinner.style.display = 'inline-block';
    if (btnText) btnText.style.display = 'none';

    try {
      const url = mode === 'create' ? API_URL : `${API_URL}/${internalId}`;
      const method = mode === 'create' ? 'POST' : 'PUT';

      const payload: any = { 
          cedula: cedula,
          firstName: firstName,
          lastName: lastName,
          email: email,
          phone: phone,
          city: city,
          currentBalance: balance
      };
      
      if (mode === 'edit' && internalId) {
          payload.id = internalId;
      }

      if (password) {
          payload.password = password;
          payload.passwordConfirm = confirmPassword;
      }

      const respuesta = await fetch(url, {
        method: method,
        headers: getAuthHeaders(),
        body: JSON.stringify(payload)
      });

      if (!respuesta.ok) {
        let errorMsg = `Error ${respuesta.status}`;
        try {
          const errData = await respuesta.json();
          if (errData.errors) {
              const primerCampo = Object.keys(errData.errors)[0];
              errorMsg = errData.errors[primerCampo][0];
          } else {
              errorMsg = errData.message || errData.title || errData.error || errorMsg;
          }
        } catch (e) {}

        const lowerError = errorMsg.toLowerCase();
        
        if (lowerError.includes('correo') || lowerError.includes('email')) {
            inputEmail.setCustomValidity(errorMsg);
            inputEmail.reportValidity();
        } else if (lowerError.includes('teléfono') || lowerError.includes('telefono')) {
            inputPhone.setCustomValidity(errorMsg);
            inputPhone.reportValidity();
        } else if (lowerError.includes('cédula') || lowerError.includes('cedula')) {
            inputCedula.setCustomValidity(errorMsg);
            inputCedula.reportValidity();
        } else {
            showToast(errorMsg, true); 
        }
        
        throw new Error("Validation failed from backend"); 
      }
      
      let finalCustomerId = internalId;
      if (mode === 'create') {
          try {
              const createdCustomer = await respuesta.json();
              finalCustomerId = createdCustomer.id || createdCustomer.Id || createdCustomer.customerId || createdCustomer.CustomerId;
          } catch(e) { } 
      }
      
      if (finalCustomerId) {
          const picUrl = `${API_URL}/${finalCustomerId}/profile-picture`;
          if (deletePicFlag) {
              await fetch(picUrl, { method: 'DELETE', headers: { 'Authorization': `Bearer ${tokenLocal}` } });
          } else if (fileToUpload) {
              const formData = new FormData();
              formData.append('image', fileToUpload);
              await fetch(picUrl, { method: 'POST', headers: { 'Authorization': `Bearer ${tokenLocal}` }, body: formData });
          }
      }
      
      // Forzar cierre directo sin preguntar (ya que guardó con éxito)
      (window as any).forceCloseClienteModal();
      
      if (deletePicFlag || fileToUpload) {
          sessionStorage.setItem('cliente_photo_changed', 'true');
          window.location.reload();
      } else {
          showToast(`Cliente ${mode === 'create' ? 'creado' : 'actualizado'} exitosamente`);
          cargarDatos();
      }
    } catch (error: any) {
        // El error ya fue reportado visualmente o vía Toast
    } finally {
      if (btnGuardar) (btnGuardar as HTMLButtonElement).disabled = false;
      if (btnSpinner) btnSpinner.style.display = 'none';
      if (btnText) btnText.style.display = 'inline';
    }
  });

  const btnConfirmDelete = document.getElementById('btnConfirmDelete');
  btnConfirmDelete?.addEventListener('click', async () => {
    if (!clienteIdAEliminar) return;
    
    const btnText = document.getElementById('btnDeleteText');
    const btnSpinner = document.getElementById('btnDeleteSpinner');
    const btn = btnConfirmDelete as HTMLButtonElement;

    if (btn) btn.disabled = true;
    if (btnSpinner) btnSpinner.style.display = 'inline-block';
    if (btnText) btnText.style.display = 'none';

    try {
      const respuesta = await fetch(`${API_URL}/${clienteIdAEliminar}`, {
        method: 'DELETE',
        headers: getAuthHeaders()
      });

      if (!respuesta.ok) {
        let errorMsg = `Error ${respuesta.status}`;
        try {
          const errData = await respuesta.json();
          errorMsg = errData.message || errData.error || errData.title || errorMsg;
        } catch (e) { }
        throw new Error(errorMsg); 
      }
      
      showToast('Cliente eliminado exitosamente');
      (window as any).cerrarModalDelete();
      cargarDatos();
    } catch (error: any) {
      showToast(error.message, true);
      (window as any).cerrarModalDelete();
    } finally {
      if (btn) btn.disabled = false;
      if (btnSpinner) btnSpinner.style.display = 'none';
      if (btnText) btnText.style.display = 'inline';
    }
  });

  function showToast(message: string, isError: boolean = false) {
    const toast = document.getElementById('toastNotif') as HTMLElement;
    const toastMsg = document.getElementById('toastMsg');
    if (toast && toastMsg) {
      toastMsg.textContent = message;
      toast.style.background = isError ? 'var(--color-danger)' : 'var(--color-success)';
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 5000);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
      if (!isAdmin) {
          const btnInsertar = document.querySelector('.header-actions .btn-primary');
          if (btnInsertar) (btnInsertar as HTMLElement).style.display = 'none';
          
          const colAcciones = document.querySelector('.col-acciones');
          if (colAcciones) (colAcciones as HTMLElement).style.display = 'none';
      }
      cargarDatos();
  });
</script>