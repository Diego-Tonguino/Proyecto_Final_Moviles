// Iconos SVG para mostrar/ocultar la contraseña
const eyeIconOpen = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="currentColor" d="M10 3.5C5.83 3.5 2.1 6.06.66 10c1.44 3.94 5.17 6.5 9.34 6.5s7.9-2.56 9.34-6.5C17.9 6.06 14.17 3.5 10 3.5zm0 10.5a4 4 0 110-8 4 4 0 010 8zm0-6.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z"/></svg>';
const eyeIconClosed = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="currentColor" d="M1.3 1.1c.3-.3.9-.3 1.1 0l16.3 16.3c.3.3.3.9 0 1.1s-.9.3-1.1 0L1.3 2.2c-.3-.3-.3-.9 0-1.1zm3.8 3.8l1.4 1.4C5.1 7 4.1 8.4 3.6 10c.8 2.2 2.9 3.8 5.4 3.8.9 0 1.7-.2 2.4-.6l1.5 1.5C11.9 15.3 11 15.7 10 15.7 6.1 15.7 2.8 13.5 1.4 10c.8-2 2.2-3.6 3.8-5zm11.1 11.1l-1.4-1.4C14.9 13 15.9 11.6 16.4 10c-.8-2.2-2.9-3.8-5.4-3.8-.9 0-1.7.2-2.4.6l-1.5-1.5C8.1 4.7 9 4.3 10 4.3c3.9 0 7.2 2.2 8.6 5.7-.8 2-2.2 3.6-3.8 5zm-3.4-3.4l1.3 1.3a3.5 3.5 0 01-4.7-4.7l1.3 1.3a1.5 1.5 0 002.1 2.1z"/></svg>';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=sssdevice-width, initial-scale=1.0">
    <title>Iniciar Sesión | NorthWind</title>
    <style>
        /* Paleta Profesional y Reset */
        :root {
            --bg-page-top: #1a103c;
            --bg-page-bottom: #2d1b63;
            --card-bg: rgba(255, 255, 255, 0.03);
            --card-border: rgba(255, 255, 255, 0.08);
            --primary: #7c3aed; 
            --primary-hover: #6d28d9;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(0, 0, 0, 0.2);
            --input-border: rgba(255, 255, 255, 0.1);
            --input-focus: rgba(124, 58, 237, 0.5);
        }

        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }

        body { 
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: linear-gradient(rgba(15, 8, 30, 0.2), rgba(26, 16, 60, 0.3)), url('/fondo_web.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            color: var(--text-main); 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            overflow: hidden; 
        }

        /* Tarjeta Premium */
        .login-card { 
            background: var(--card-bg); 
            backdrop-filter: blur(24px); 
            -webkit-backdrop-filter: blur(24px); 
            border: 1px solid var(--card-border); 
            border-radius: 1.25rem; 
            padding: 3.5rem 3rem; 
            width: 100%; 
            max-width: 440px; 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255,255,255,0.02) inset; 
        }

        .header-section {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .header-section h1 { 
            font-size: 1.875rem; 
            font-weight: 700; 
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem; 
            color: #ffffff;
        }

        .header-section p { 
            color: var(--text-muted); 
            font-size: 0.95rem; 
        }

        /* Formulario Estructurado */
        form { 
            display: flex; 
            flex-direction: column; 
            gap: 1.5rem; 
        }

        .input-group { 
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            text-align: left;
        }

        .input-group label {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper input { 
            width: 100%; 
            background: var(--input-bg); 
            border: 1px solid var(--input-border); 
            border-radius: 0.5rem; 
            padding: 0.875rem 1rem; 
            color: var(--text-main); 
            font-size: 1rem; 
            outline: none;
            transition: all 0.2s ease;
        }

        .input-wrapper input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--input-focus);
            background: rgba(0, 0, 0, 0.3);
        }

        .input-wrapper input::placeholder { 
            color: rgba(148, 163, 184, 0.5); 
        }

        /* Botón de Contraseña */
        .password-wrapper input { 
            padding-right: 3rem; 
        }
        
        .password-toggle { 
            position: absolute; 
            right: 0.75rem; 
            top: 50%; 
            transform: translateY(-50%); 
            background: none; 
            border: none; 
            cursor: pointer; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            padding: 0.25rem;
            color: var(--text-muted);
            transition: color 0.2s;
        }

        .password-toggle:hover { color: var(--text-main); }
        .password-toggle .eye-closed { display: none; }
        .password-toggle.is-hidden .eye-open { display: none; }
        .password-toggle.is-hidden .eye-closed { display: block; }

        /* Botón de Envío Corporativo */
        .btn-submit { 
            background-color: var(--primary); 
            border: 1px solid rgba(255,255,255,0.1) inset; 
            border-radius: 0.5rem; 
            padding: 0.875rem; 
            color: white; 
            font-weight: 600; 
            font-size: 1rem; 
            cursor: pointer; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            margin-top: 0.5rem; 
            width: 100%; 
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .btn-submit:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.4); 
        }

        .btn-submit:active {
            transform: translateY(1px);
            box-shadow: 0 2px 10px rgba(168, 85, 247, 0.3);
        }
        
        .btn-submit:disabled {
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
            opacity: 0.7;
        }

        /* Footer del formulario */
        .form-footer { 
            text-align: center;
            margin-top: 2rem; 
            padding-top: 1.5rem;
            border-top: 1px solid var(--card-border);
        }

        .form-footer p {
            color: var(--text-muted); 
            font-size: 0.875rem; 
        }

        .form-footer a { 
            color: #a78bfa; 
            text-decoration: none; 
            font-weight: 500; 
            transition: color 0.2s;
            margin-left: 0.25rem;
        }

        .form-footer a:hover { 
            color: #c4b5fd;
            text-decoration: underline; 
        }
    </style>
</head>
<body>
    <div class="login-card">
        
        <div class="header-section">
            <h1>Bienvenido</h1>
            <p>Ingresa tus credenciales para continuar</p>
        </div>

        <form id="loginForm">
            
            <div class="input-group">
                <label for="email">Correo electrónico</label>
                <div class="input-wrapper">
                    <input type="email" id="email" name="email" placeholder="ejemplo@empresa.com" required>
                </div>
            </div>

            <div class="input-group">
                <label for="password">Contraseña</label>
                <div class="input-wrapper password-wrapper">
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                    <button type="button" class="password-toggle" id="passwordToggle" aria-label="Cambiar visibilidad de contraseña">
                        <span class="eye-open" set:html={eyeIconOpen}></span>
                        <span class="eye-closed" set:html={eyeIconClosed}></span>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-submit">Iniciar sesión</button>
        </form>


    </div>

<script is:inline>
    // Decodificador seguro para obtener datos del Token
    function parseJwt(token) {
        try {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        } catch (e) {
            return null;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const passwordInput = document.getElementById('password');
        const passwordToggle = document.getElementById('passwordToggle');
        const loginForm = document.getElementById('loginForm');
        const btnSubmit = document.querySelector('.btn-submit');

        passwordToggle.addEventListener('click', () => {
            const isHidden = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isHidden ? 'text' : 'password');
            passwordToggle.classList.toggle('is-hidden');
        });

        function mostrarError(mensaje) {
            let errorDiv = document.getElementById('loginError');
            if (!errorDiv) {
                errorDiv = document.createElement('div');
                errorDiv.id = 'loginError';
                errorDiv.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
                errorDiv.style.border = '1px solid rgba(220, 38, 38, 0.3)';
                errorDiv.style.color = '#fca5a5';
                errorDiv.style.padding = '0.875rem';
                errorDiv.style.borderRadius = '0.5rem';
                errorDiv.style.marginBottom = '1rem';
                errorDiv.style.textAlign = 'center';
                loginForm.insertBefore(errorDiv, loginForm.firstChild);
            }
            errorDiv.textContent = mensaje;
        }

        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const errorDiv = document.getElementById('loginError');
            if (errorDiv) errorDiv.remove();

            const formData = new FormData(loginForm);
            const data = Object.fromEntries(formData);
            const originalText = btnSubmit.textContent;

            btnSubmit.textContent = 'Verificando...';
            btnSubmit.disabled = true;

            try {
                const response = await fetch("http://localhost:5033/api/auth/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ userName: data.email, password: data.password })
                });

                if (response.ok) {
                    const result = await response.json();
                    
                    const tokenString = result.token || result.Token || result.accessToken; 
                    if (tokenString) localStorage.setItem('northwind_token', tokenString);

                    // =====================================
                    // 1. EXTRAER EL NOMBRE Y EMAIL DEL JWT
                    // =====================================
                    let userNameString = data.email; 
                    let userIdString = "";
                    let userEmailString = data.email; // Guardamos el email del formulario como fallback seguro
                    
                    if (tokenString) {
                        const decoded = parseJwt(tokenString);
                        if (decoded) {
                            userNameString = decoded.FullName || decoded.fullName || decoded.Name || decoded.name || decoded.given_name || data.email;
                            userIdString = decoded.sub || decoded.nameid || decoded['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier'] || decoded.uid || decoded.id || '';
                            
                            // Extraer email del JWT (intentando todas las variantes comunes de ASP.NET Identity)
                            userEmailString = decoded.email 
                                || decoded.Email
                                || decoded['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress']
                                || decoded['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name']
                                || decoded.unique_name
                                || decoded.preferred_username
                                || data.email; // Fallback: el correo que el usuario escribió en el formulario
                        }
                    }

                    // =====================================
                    // 2. EXTRAER EL ROL
                    // =====================================
                    let userRoleString = "Cliente"; 
                    if (result.roles && result.roles.length > 0) {
                        userRoleString = result.roles[0]; 
                    }
                    
                    // Guardar en LocalStorage
                    localStorage.setItem('northwind_user_name', userNameString);
                    localStorage.setItem('northwind_user_role', userRoleString);
                    localStorage.setItem('northwind_user_id', userIdString);
                    localStorage.setItem('northwind_user_email', userEmailString);

                    setTimeout(() => { window.location.href = '/'; }, 100);
                } else {
                    const errorData = await response.json().catch(() => null);
                    let errorMessage = "Correo o contraseña incorrectos.";
                    
                    if (errorData) {
                        // Detectamos si el API de C# devuelve que la cuenta está bloqueada
                        // ASP.NET Identity suele enviar "IsLockedOut", "Locked out" o similar.
                        const errorText = JSON.stringify(errorData).toLowerCase();
                        if (errorText.includes('locked out') || errorText.includes('bloqueada') || errorText.includes('lockedout')) {
                            errorMessage = "Tu cuenta ha sido bloqueada tras 3 intentos fallidos. Contacta al administrador para desbloquearla.";
                        } else if (errorData.message) {
                            errorMessage = errorData.message;
                        }
                    }

                    mostrarError(errorMessage);
                    btnSubmit.textContent = originalText;
                    btnSubmit.disabled = false;
                }
            } catch (error) {
                mostrarError("No se pudo conectar con el servidor.");
                btnSubmit.textContent = originalText;
                btnSubmit.disabled = false;
            }
        });
    });
</script>
</body>
</html>