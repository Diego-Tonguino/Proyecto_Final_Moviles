---
// src/components/ProductoModal.astro
---
<div id="productoModal" class="modal-overlay" style="display: none;">
  <div class="modal-glass-card">
    <div class="modal-header">
      <h2>Seleccionar Productos</h2>
      <button id="closeProdModalBtn" class="close-btn">&times;</button>
    </div>
    <div class="modal-body">
      <div class="search-wrapper">
        <div class="filter-group">
          <span class="filter-label">Filtrar por:</span>
          <select id="searchFilterModalProductos" class="search-select-dark">
            <option value="Todo">Todo</option>
            <option value="Id">ID</option>
            <option value="Nombre">Nombre</option>
          </select>
        </div>
        <div class="search-input-container">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="searchProductos" placeholder="Buscar desde el inicio..." autocomplete="off" maxlength="30" />
        </div>
      </div>
      <div class="table-outer">
        <div class="table-scroll">
          <table class="productos-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Stock</th>
                <th style="text-align: right;">Precio</th>
              </tr>
            </thead>
            <tbody id="tablebodyProd">
              <tr class="state-row"><td colspan="4" style="text-align:center; padding:2rem;">Cargando catálogo...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="pagination-bar">
          <span id="paginationInfoProd">Iniciando...</span>
          <div class="btns">
            <button class="p-btn">&laquo;</button>
            <button class="p-btn active">1</button>
            <button class="p-btn">&raquo;</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
  }

  .modal-glass-card {
    background: rgba(30, 20, 60, 0.9);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    width: 90%;
    max-width: 700px;
    max-height: 85vh;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .modal-header h2 { color: white; font-size: 1.25rem; margin: 0; }

  .close-btn {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: white;
    font-size: 1.5rem;
    width: 32px; height: 32px;
    border-radius: 50%;
    cursor: pointer;
  }

  .modal-body { padding: 1.5rem 2rem; display: flex; flex-direction: column; gap: 1.5rem; }

  .search-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 0.5rem; }
  .filter-group { display: flex; align-items: center; gap: 8px; }
  .filter-label { color: #94a3b8; font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .search-input-container { position: relative; display: flex; align-items: center; flex: 1;}
  .search-icon { position: absolute; left: 1rem; color: #94a3b8; }
  
  .search-select-dark { padding: 10px 16px; border-radius: 0.75rem; border: 1px solid rgba(255, 255, 255, 0.1); background-color: rgba(0, 0, 0, 0.3); color: white; font-size: 0.95rem; outline: none; cursor: pointer; transition: border-color 0.3s ease; }
  .search-select-dark:focus { border-color: #7c3aed; background-color: rgba(0, 0, 0, 0.5); }
  .search-select-dark option { background-color: #1a103c; color: white; }

  .search-input-container input {
    width: 100%;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 0.8rem 1rem 0.8rem 3rem;
    color: white;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .search-input-container input:focus { border-color: #7c3aed; background-color: rgba(0, 0, 0, 0.5); }

  .table-outer { border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 0.75rem; background: rgba(0, 0, 0, 0.2); overflow: hidden; }
  .table-scroll { max-height: 350px; overflow-y: auto; }
  .productos-table { width: 100%; border-collapse: collapse; text-align: left; }
  .productos-table thead th { background: rgba(255, 255, 255, 0.03); padding: 1rem; color: #94a3b8; font-size: 0.8rem; text-transform: uppercase; position: sticky; top: 0; }
  .productos-table tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.03); cursor: pointer; transition: all 0.15s; }
  .productos-table tbody tr:hover { background: rgba(124, 58, 237, 0.15); }
  .productos-table td { padding: 1rem; color: #cbd5e1; font-size: 0.95rem; }

  .pagination-bar { padding: 1rem; display: flex; justify-content: space-between; align-items: center; background: rgba(0, 0, 0, 0.2); font-size: 0.85rem; color: #94a3b8; }
  .p-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white; padding: 0.3rem 0.8rem; border-radius: 0.4rem; cursor: pointer; }
  .p-btn.active { background: #7c3aed; border-color: #7c3aed; }

  .prod-row.disabled {
    opacity: 0.35;
    cursor: not-allowed !important;
    background: rgba(255, 255, 255, 0.02);
    pointer-events: none;
  }
</style>

<script>
  let todosProductos = [];
  let productosFiltrados = []; 
  let paginaActualProd = 1;
  const itemsPorPaginaProd = 6;

  const modal = document.getElementById('productoModal');
  const tablebody = document.getElementById('tablebodyProd');
  const searchInput = document.getElementById('searchProductos');
  const paginationInfo = document.getElementById('paginationInfoProd');
  const paginationBtns = document.querySelector('#productoModal .btns');

  async function cargarProductos() {
    if (paginationInfo) paginationInfo.textContent = "Cargando...";
    try {
      const response = await fetch('http://localhost:5033/api/products'); 
      const data = await response.json();
      
      // Filtramos para que solo existan los que tienen stock > 0
      todosProductos = data.filter(p => Number(p.unitsInStock ?? p.UnitsInStock ?? 0) > 0);
      productosFiltrados = [...todosProductos];
      
      paginaActualProd = 1;
      renderizarPaginaProd();
    } catch (e) {
      console.error('Error cargando productos:', e);
      if (tablebody) tablebody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:2rem;">Error al conectar con la API</td></tr>';
      if (paginationInfo) paginationInfo.textContent = "Error";
    }
  }

  function renderizarPaginaProd() {
    if (!tablebody) return;

    const inicio = (paginaActualProd - 1) * itemsPorPaginaProd;
    const fin = inicio + itemsPorPaginaProd;
    const productosPagina = productosFiltrados.slice(inicio, fin);

    if (paginationInfo) {
      paginationInfo.textContent = `Mostrando ${productosPagina.length} de ${productosFiltrados.length} productos (Pág ${paginaActualProd})`;
    }

    const idsAgregados = Array.from(document.querySelectorAll('.item-venta'))
      .map(el => String(el.getAttribute('data-id')).trim());

    if (productosFiltrados.length === 0) {
      tablebody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:2rem;">No se encontraron productos.</td></tr>';
      renderizarControlesPaginacion(0);
      return;
    }

    tablebody.innerHTML = productosPagina.map(p => {
      const id = String(p.id || p.Id).trim();
      const stock = Number(p.unitsInStock ?? p.UnitsInStock ?? 0);
      const precio = Number(p.unitPrice ?? p.UnitPrice ?? 0);
      
      const deshabilitar = idsAgregados.includes(id) || stock <= 0;
      
      return `
        <tr class="prod-row ${deshabilitar ? 'disabled' : ''}" 
            data-id="${id}" 
            data-name="${(p.name || p.Name || '').replace(/"/g, '&quot;')}" 
            data-price="${precio}" 
            data-stock="${stock}">
          <td><span style="color:#a78bfa; font-weight:bold;">${id}</span></td>
          <td>${p.name || p.Name}</td>
          <td style="color:#94a3b8;">${stock}</td>
          <td style="text-align: right; color:#86efac;">$${precio.toFixed(2)}</td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.prod-row:not(.disabled)').forEach(row => {
      row.addEventListener('click', () => {
        const producto = {
          id: row.getAttribute('data-id'),
          name: row.getAttribute('data-name'),
          unitPrice: parseFloat(row.getAttribute('data-price') || '0'),
          unitsInStock: parseInt(row.getAttribute('data-stock') || '0')
        };
        
        window.dispatchEvent(new CustomEvent('productoSeleccionado', { detail: producto }));
        if (modal) modal.style.display = 'none';
      });
    });

    renderizarControlesPaginacion(Math.ceil(productosFiltrados.length / itemsPorPaginaProd));
  }

  function renderizarControlesPaginacion(totalPaginas) {
    if (!paginationBtns) return;
    
    let html = `<button class="p-btn" id="btnPrevProd" ${paginaActualProd === 1 || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&laquo;</button>`;
    
    for (let i = 1; i <= totalPaginas; i++) {
      html += `<button class="p-btn ${i === paginaActualProd ? 'active' : ''}" data-page-prod="${i}">${i}</button>`;
    }
    
    html += `<button class="p-btn" id="btnNextProd" ${paginaActualProd === totalPaginas || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&raquo;</button>`;
    
    paginationBtns.innerHTML = html;

    document.getElementById('btnPrevProd')?.addEventListener('click', () => {
      if (paginaActualProd > 1) { paginaActualProd--; renderizarPaginaProd(); }
    });
    
    document.getElementById('btnNextProd')?.addEventListener('click', () => {
      if (paginaActualProd < totalPaginas) { paginaActualProd++; renderizarPaginaProd(); }
    });
    
    paginationBtns.querySelectorAll('button[data-page-prod]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        paginaActualProd = parseInt(e.target.getAttribute('data-page-prod') || '1');
        renderizarPaginaProd();
      });
    });
  }

  function aplicarFiltrosModalProd() {
    const term = searchInput.value.toLowerCase().trim();
    const filterType = (document.getElementById('searchFilterModalProductos') as HTMLSelectElement)?.value || "Todo";

    productosFiltrados = todosProductos.filter(p => {
      const id = String(p.id || p.Id || "").toLowerCase();
      const nombre = (p.name || p.Name || "").toLowerCase();

      let matchText = false;
      
      // === REGLA ESTRICTA DE BÚSQUEDA DESDE LA PRIMERA LETRA/NÚMERO ===
      if (filterType === "Id") {
        matchText = id.startsWith(term);
      } else if (filterType === "Nombre") {
        matchText = nombre.startsWith(term);
      } else {
        matchText = id.startsWith(term) || nombre.startsWith(term);
      }

      return matchText;
    });
    paginaActualProd = 1; 
    renderizarPaginaProd();
  }

  const searchFilterModalProd = document.getElementById('searchFilterModalProductos') as HTMLSelectElement;
  searchInput?.addEventListener('input', aplicarFiltrosModalProd);
  searchFilterModalProd?.addEventListener('change', aplicarFiltrosModalProd);

  window.abrirModalProductos = () => {
    if (modal) {
      modal.style.display = 'flex';
      cargarProductos();
    }
  };

  document.getElementById('closeProdModalBtn')?.addEventListener('click', () => {
    if (modal) modal.style.display = 'none';
  });
</script>