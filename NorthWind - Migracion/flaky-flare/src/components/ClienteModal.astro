---
// src/components/ClienteModal.astro
---

<div id="clienteModal" class="modal-overlay" style="display: none;">
  <div class="modal-glass-card">
    <div class="modal-header">
      <h2>Seleccionar Cliente</h2>
      <button id="closeModalBtn" class="close-btn" aria-label="Cerrar">&times;</button>
    </div>
    
    <div class="modal-body">
      <div class="search-wrapper">
        <div class="filter-group">
          <span class="filter-label">Filtrar por:</span>
          <select id="searchFilterModalClientes" class="search-select-dark">
            <option value="Todo">Todo</option>
            <option value="Cedula">Cédula</option>
            <option value="Nombre">Nombre</option>
            <option value="Apellido">Apellido</option>
            <option value="Email">Email</option>
            <option value="Telefono">Teléfono</option>
            <option value="Direccion">Dirección</option>
          </select>
        </div>
        <div class="search-input-container">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="searchClientes" placeholder="Buscar desde el inicio..." autocomplete="off" maxlength="50" />
        </div>
      </div>

      <div class="table-outer">
        <div class="table-scroll">
          <table class="custom-table">
            <thead>
              <tr>
                <th style="width: 10%;">CÉDULA</th>
                <th style="width: 12%;">NOMBRE</th>
                <th style="width: 12%;">APELLIDO</th>
                <th style="width: 13%;">TELÉFONO</th>
                <th style="width: 20%;">CORREO ELECTRÓNICO</th>
                <th style="width: 20%;">DIRECCIÓN</th>
                <th style="text-align: right; width: 13%;">BALANCE ACTUAL</th>
              </tr>
            </thead>
            <tbody id="tablebody">
              <tr class="state-row">
                <td colspan="7" style="text-align: center; padding: 3rem;">Cargando datos de Northwind...</td>
              </tr>
            </tbody>
          </table>
        </div>
        
        <div class="pagination-bar">
          <span id="paginationInfo">Cargando...</span>
          <div class="btns">
            <button class="p-btn">&laquo;</button>
            <button class="p-btn active">1</button>
            <button class="p-btn">&raquo;</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
  }

  /* --- MODAL MUCHO MÁS ANCHO Y ADAPTABLE --- */
  .modal-glass-card {
    background: rgba(30, 20, 60, 0.9);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    width: 95%;
    max-width: 1400px; 
    max-height: 90vh;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header {
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .modal-header h2 { color: white; font-size: 1.35rem; margin: 0; }

  .close-btn {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: white;
    font-size: 1.5rem;
    width: 32px; height: 32px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s;
  }
  .close-btn:hover { background: rgba(239, 68, 68, 0.2); color: #ef4444; }

  .modal-body { padding: 1.5rem 2rem; display: flex; flex-direction: column; gap: 1.5rem; }

  .search-wrapper { display: flex; align-items: center; gap: 12px; margin-bottom: 0.5rem; }
  .filter-group { display: flex; align-items: center; gap: 8px; }
  .filter-label { color: #94a3b8; font-size: 0.9rem; font-weight: 500; white-space: nowrap; }
  .search-input-container { position: relative; display: flex; align-items: center; flex: 1;}
  .search-icon { position: absolute; left: 1rem; color: #94a3b8; }
  
  .search-select-dark { padding: 10px 16px; border-radius: 0.75rem; border: 1px solid rgba(255, 255, 255, 0.1); background-color: rgba(0, 0, 0, 0.3); color: white; font-size: 0.95rem; outline: none; cursor: pointer; transition: border-color 0.3s ease; }
  .search-select-dark:focus { border-color: #7c3aed; background-color: rgba(0, 0, 0, 0.5); }
  .search-select-dark option { background-color: #1a103c; color: white; }

  .search-input-container input {
    width: 100%;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 0.8rem 1rem 0.8rem 3rem;
    color: white;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .search-input-container input:focus { border-color: #7c3aed; background-color: rgba(0, 0, 0, 0.5); }

  .table-outer { border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 0.75rem; background: rgba(0, 0, 0, 0.2); overflow: hidden; }
  
  .table-scroll { max-height: 600px; overflow-y: auto; }
  
  /* --- ANCHO MÍNIMO EN LA TABLA PARA EVITAR QUE SE APLASTE --- */
  .custom-table { width: 100%; border-collapse: collapse; text-align: left; min-width: 1050px; }
  .custom-table thead th { background: rgba(255, 255, 255, 0.03); padding: 1rem; color: #94a3b8; font-size: 0.8rem; text-transform: uppercase; position: sticky; top: 0; z-index: 1; white-space: nowrap; }
  .custom-table tbody tr { border-bottom: 1px solid rgba(255, 255, 255, 0.03); cursor: pointer; transition: all 0.15s; }
  .custom-table tbody tr:hover { background: rgba(124, 58, 237, 0.15); }
  .custom-table td { padding: 1.2rem 1rem; color: #cbd5e1; font-size: 0.95rem; }

  .pagination-bar { padding: 1.2rem 1.5rem; display: flex; justify-content: space-between; align-items: center; background: rgba(0, 0, 0, 0.2); font-size: 0.85rem; color: #94a3b8; border-top: 1px solid rgba(255,255,255,0.05); }
  .p-btn { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white; padding: 0.4rem 0.9rem; border-radius: 0.4rem; cursor: pointer; transition: all 0.2s; }
  .p-btn:hover:not(:disabled) { background: rgba(255,255,255,0.1); }
  .p-btn.active { background: #7c3aed; border-color: #7c3aed; }

  /* Asegurar el scroll de la scrollbar para que sea estético */
  .table-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
  .table-scroll::-webkit-scrollbar-track { background: transparent; }
  .table-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }
  .table-scroll::-webkit-scrollbar-thumb:hover { background: rgba(124, 58, 237, 0.5); }
</style>

<script>
  interface Cliente {
    id?: string; Id?: string; customerId?: string; CustomerId?: string;
    cedula?: string; Cedula?: string;
    firstName?: string; FirstName?: string; 
    lastName?: string; LastName?: string; 
    companyName?: string; CompanyName?: string; 
    email?: string; Email?: string;
    phone?: string; Phone?: string;
    address?: string; Address?: string;
    city?: string; City?: string;
    country?: string; Country?: string;
    postalCode?: string; PostalCode?: string;
    currentBalance?: number; CurrentBalance?: number;
  }

  let todosClientes: Cliente[] = [];
  let clientesFiltrados: Cliente[] = []; 
  let paginaActual = 1;
  const itemsPorPagina = 8; 

  const modal = document.getElementById('clienteModal');
  const tablebody = document.getElementById('tablebody');
  const searchInput = document.getElementById('searchClientes') as HTMLInputElement;
  const paginationInfo = document.getElementById('paginationInfo');
  const paginationBtns = document.querySelector('#clienteModal .btns'); 

  const closeModal = () => { if (modal) modal.style.display = 'none'; };

  const tokenLocal = localStorage.getItem('northwind_token') || '';
  function getAuthHeaders() {
    return {
      'Content-Type': 'application/json',
      'Authorization': tokenLocal ? `Bearer ${tokenLocal}` : ''
    };
  }

  async function cargarClientes() {
    try {
      const response = await fetch('https://northwind-api-uta-anffgshdbxfjaecr.switzerlandnorth-01.azurewebsites.net/api/customers', { headers: getAuthHeaders() });
      if (!response.ok) throw new Error('Error al conectar');
      const data: Cliente[] = await response.json();
      
      const clientesSinDeuda = data.filter(c => {
        const balance = (c.currentBalance !== undefined) ? c.currentBalance : (c.CurrentBalance || 0);
        return balance <= 0;
      });

      todosClientes = clientesSinDeuda;
      clientesFiltrados = clientesSinDeuda;
      paginaActual = 1; 
      renderizarPagina();
    } catch (e) {
      console.error("Error cargando clientes:", e);
      if (tablebody) tablebody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:3rem; color:#ef4444;">Error al conectar con la API de clientes</td></tr>';
    }
  }

  function renderizarPagina() {
    if (!tablebody) return;

    const inicio = (paginaActual - 1) * itemsPorPagina;
    const fin = inicio + itemsPorPagina;
    const clientesPagina = clientesFiltrados.slice(inicio, fin);

    if (paginationInfo) {
      paginationInfo.textContent = `Mostrando ${clientesPagina.length} de ${clientesFiltrados.length} clientes aptos (Pág ${paginaActual})`;
    }

    if (clientesFiltrados.length === 0) {
      tablebody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:3rem; color:#94a3b8;">No se encontraron clientes sin deuda</td></tr>';
      renderizarControlesPaginacion(0);
      return;
    }

    tablebody.innerHTML = clientesPagina.map(c => {
      const cedula = c.cedula || c.Cedula || 'N/A';
      const firstName = c.firstName || c.FirstName || '';
      const lastName = c.lastName || c.LastName || '';
      const phone = c.phone || c.Phone || 'Sin teléfono';
      const email = c.email || c.Email || 'No registrado';
      const address = c.address || c.Address || 'Sin dirección';
      const balance = Number(c.currentBalance ?? c.CurrentBalance ?? 0);

      const clienteJson = encodeURIComponent(JSON.stringify(c)).replace(/'/g, "%27");

      return `
        <tr class="cliente-row" data-json="${clienteJson}">
          <td><span style="color:#a78bfa; font-weight:bold; letter-spacing: 0.5px;">${cedula}</span></td>
          <td style="font-weight: 600; color: white; white-space: nowrap;">${firstName}</td>
          <td style="font-weight: 600; color: white; white-space: nowrap;">${lastName}</td>
          <td style="color: #cbd5e1; white-space: nowrap;">${phone}</td>
          <td style="color: #93c5fd; white-space: nowrap;">${email}</td>
          <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${address}">${address}</td>
          <td style="text-align: right; color: #86efac; font-weight: 600; white-space: nowrap;">$${balance.toFixed(2)}</td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.cliente-row').forEach(row => {
      row.addEventListener('click', () => {
        const jsonEncoded = row.getAttribute('data-json');
        if(jsonEncoded) {
          const clienteObj = JSON.parse(decodeURIComponent(jsonEncoded));
          window.dispatchEvent(new CustomEvent('clienteSeleccionado', { 
            detail: clienteObj 
          }));
          closeModal();
        }
      });
    });

    renderizarControlesPaginacion(Math.ceil(clientesFiltrados.length / itemsPorPagina));
  }

  function renderizarControlesPaginacion(totalPaginas: number) {
    if (!paginationBtns) return;
    
    let html = `<button class="p-btn" id="btnPrevModal" ${paginaActual === 1 || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&laquo;</button>`;
    
    for (let i = 1; i <= totalPaginas; i++) {
      html += `<button class="p-btn ${i === paginaActual ? 'active' : ''}" data-page="${i}">${i}</button>`;
    }
    
    html += `<button class="p-btn" id="btnNextModal" ${paginaActual === totalPaginas || totalPaginas === 0 ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>&raquo;</button>`;
    
    paginationBtns.innerHTML = html;

    document.getElementById('btnPrevModal')?.addEventListener('click', () => {
      if (paginaActual > 1) { paginaActual--; renderizarPagina(); }
    });
    
    document.getElementById('btnNextModal')?.addEventListener('click', () => {
      if (paginaActual < totalPaginas) { paginaActual++; renderizarPagina(); }
    });
    
    paginationBtns.querySelectorAll('button[data-page]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        paginaActual = parseInt((e.target as HTMLElement).getAttribute('data-page') || '1');
        renderizarPagina();
      });
    });
  }

  function aplicarFiltrosModal() {
    const term = searchInput.value.toLowerCase().trim();
    const filterType = (document.getElementById('searchFilterModalClientes') as HTMLSelectElement)?.value || "Todo";

    clientesFiltrados = todosClientes.filter(c => {
      const cedulaStr = String(c.cedula || c.Cedula || "").toLowerCase();
      const firstName = String(c.firstName || c.FirstName || "").toLowerCase();
      const lastName = String(c.lastName || c.LastName || "").toLowerCase();
      const email = String(c.email || c.Email || "").toLowerCase();
      const phone = String(c.phone || c.Phone || "").toLowerCase();
      const address = String(c.address || c.Address || "").toLowerCase();

      let matchText = false;
      
      // === REGLA ESTRICTA DE BÚSQUEDA DESDE LA PRIMERA LETRA/NÚMERO ===
      if (filterType === "Cedula") {
        matchText = cedulaStr.startsWith(term);
      } else if (filterType === "Nombre") {
        matchText = firstName.startsWith(term);
      } else if (filterType === "Apellido") {
        matchText = lastName.startsWith(term);
      } else if (filterType === "Email") {
        matchText = email.startsWith(term);
      } else if (filterType === "Telefono") {
        matchText = phone.startsWith(term);
      } else if (filterType === "Direccion") {
        matchText = address.startsWith(term);
      } else {
        matchText = cedulaStr.startsWith(term) || 
                    firstName.startsWith(term) || 
                    lastName.startsWith(term) || 
                    email.startsWith(term) || 
                    phone.startsWith(term) || 
                    address.startsWith(term);
      }

      return matchText;
    });
    
    paginaActual = 1; 
    renderizarPagina();
  }

  const searchFilterModal = document.getElementById('searchFilterModalClientes') as HTMLSelectElement;
  searchInput?.addEventListener('input', aplicarFiltrosModal);
  searchFilterModal?.addEventListener('change', aplicarFiltrosModal);

  (window as any).abrirModalClientes = () => {
    if (modal) {
      modal.style.display = 'flex';
      cargarClientes();
    }
  };
  
  document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
</script>