# Configuración de conexión a SQL Server
# Actualiza estos valores según tu servidor local

# Nombre del servidor SQL Server (ej: ALEXANDER, localhost, 127.0.0.1)
DB_SERVER=ALEXANDER

# Nombre de la base de datos
DB_NAME=NorthWindUsersDB

# Usuario de SQL Server (si uses autenticación Windows, dejar vacío)
DB_USER=diego

# Contraseña de SQL Server (si Uses autenticación Windows, dejar vacío)
DB_PASSWORD=

# Puerto (por defecto 1433)
# DB_PORT=1433
