using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Options;
using NorthWind.Sales.Backend.DataContexts.EFCore.Options;
using NorthWind.Sales.Backend.Repositories.Entities;
using NorthWind.Sales.Backend.Repositories.Interfaces;

namespace NorthWind.Sales.Backend.DataContexts.EFCore.DataContexts
{
    internal class NorthWindDomainLogsContext(IOptions<DBOptions> dbOptions)
: DbContext, INorthWindDomainLogsDataContext
    {
        public DbSet<DomainLog> DomainLogs { get; set; }
        protected override void OnConfiguring(
        DbContextOptionsBuilder optionsBuilder)
        {
            optionsBuilder.UseSqlServer(
            dbOptions.Value.DomainLogsConnectionString);
        }

        public async Task AddLogAsync(DomainLog log)
        {
            await DomainLogs.AddAsync(log);
        }

        public async Task SaveChangesAsync()
        {
            await base.SaveChangesAsync();
        }

        public async Task<IEnumerable<DomainLog>> GetAllLogsAsync()
        {
            return await DomainLogs.Take(1000).ToListAsync();
        }
    }
}
