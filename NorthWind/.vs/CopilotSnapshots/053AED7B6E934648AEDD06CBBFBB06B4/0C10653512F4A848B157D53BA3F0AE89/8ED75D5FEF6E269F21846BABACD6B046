using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using System.Linq;
using NorthWind.Sales.Backend.Repositories.Entities;
using NorthWind.Sales.Backend.Repositories.Interfaces;
using System.Threading.Tasks;

namespace NorthWind.Sales.Backend.Controllers.Admin;

public static class CustomersController
{
    public static WebApplication UseCustomersController(this WebApplication app)
    {
        app.MapGet("/api/customers", GetAllCustomers);
        app.MapGet("/api/customers/{id}", GetCustomerById);
        app.MapPost("/api/customers", CreateCustomer);
        app.MapPut("/api/customers/{id}", UpdateCustomer);
        app.MapDelete("/api/customers/{id}", DeleteCustomer);
        return app;
    }

    static async Task<IResult> GetAllCustomers(NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesQueriesDataContext queries)
    {
        var list = await queries.ToListAsync(queries.Customers);
        return Results.Ok(list);
    }

    static async Task<IResult> GetCustomerById(string id, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesQueriesDataContext queries)
    {
        var customer = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Id == id));
        if (customer == null) return Results.NotFound();
        return Results.Ok(customer);
    }
    static async Task<IResult> CreateCustomer([FromBody] NorthWind.Sales.Backend.Repositories.Entities.Customer customer, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesAdminDataContext admin)
    {
        await admin.AddCustomerAsync(customer);
        await admin.SaveChangesAsync();
        return Results.Created($"/api/customers/{customer.Id}", customer);
    }
    static async Task<IResult> UpdateCustomer(string id, [FromBody] NorthWind.Sales.Backend.Repositories.Entities.Customer customer, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesAdminDataContext admin)
    {
        if (id != customer.Id) return Results.BadRequest();
        admin.UpdateCustomerAsync(customer);
        await admin.SaveChangesAsync();
        return Results.NoContent();
    }

    static async Task<IResult> DeleteCustomer(string id, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesAdminDataContext admin)
    {
        await admin.DeleteCustomerAsync(id);
        await admin.SaveChangesAsync();
        return Results.NoContent();
    }
}
