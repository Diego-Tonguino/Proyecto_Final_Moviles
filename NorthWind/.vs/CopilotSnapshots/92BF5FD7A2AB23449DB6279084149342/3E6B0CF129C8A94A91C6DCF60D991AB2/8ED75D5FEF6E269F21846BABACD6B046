using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using System.Linq;
using NorthWind.Sales.Backend.Repositories.Entities;
using NorthWind.Sales.Backend.Repositories.Interfaces;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Identity;
using System;

namespace NorthWind.Sales.Backend.Controllers.Admin;

public static class CustomersController
{
    public static WebApplication UseCustomersController(this WebApplication app)
    {
        app.MapGet("/api/customers", GetAllCustomers);
        app.MapGet("/api/customers/{id}", GetCustomerById);
        app.MapPost("/api/customers", CreateCustomer);
        app.MapPut("/api/customers/{id}", UpdateCustomer);
        app.MapDelete("/api/customers/{id}", DeleteCustomer);
        return app;
    }

    static async Task<IResult> GetAllCustomers(NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesQueriesDataContext queries)
    {
        var list = await queries.ToListAsync(queries.Customers);
        return Results.Ok(list);
    }

    static async Task<IResult> GetCustomerById(string id, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesQueriesDataContext queries)
    {
        var customer = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Id == id));
        if (customer == null) return Results.NotFound();
        return Results.Ok(customer);
    }

    // DTO used for creating customer from API (includes plain password)
    public record CreateCustomerDto(
        string Id,
        string FirstName,
        string LastName,
        string Email,
        string Password,
        string PasswordConfirm,
        string? City,
        string? Phone,
        decimal CurrentBalance,
        byte[]? ProfilePictureData,
        string? ProfilePictureContentType
    );

    static async Task<IResult> CreateCustomer([FromBody] CreateCustomerDto dto, INorthWindSalesAdminDataContext admin)
    {
        try
        {
            // Basic validation
            if (string.IsNullOrWhiteSpace(dto.Id)) return Results.BadRequest(new { error = "Id is required." });
            if (string.IsNullOrWhiteSpace(dto.FirstName)) return Results.BadRequest(new { error = "FirstName is required." });
            if (string.IsNullOrWhiteSpace(dto.LastName)) return Results.BadRequest(new { error = "LastName is required." });
            if (string.IsNullOrWhiteSpace(dto.Email)) return Results.BadRequest(new { error = "Email is required." });
            if (string.IsNullOrWhiteSpace(dto.Password)) return Results.BadRequest(new { error = "Password is required." });
            if (dto.Password != dto.PasswordConfirm) return Results.BadRequest(new { error = "Passwords do not match." });
            if (dto.Password.Length < 6) return Results.BadRequest(new { error = "Password must be at least 6 characters." });

            // Map DTO to entity
            var customer = new Repositories.Entities.Customer
            {
                Id = dto.Id,
                FirstName = dto.FirstName,
                LastName = dto.LastName,
                Email = dto.Email,
                City = dto.City,
                Phone = dto.Phone,
                CurrentBalance = dto.CurrentBalance,
                ProfilePictureData = dto.ProfilePictureData,
                ProfilePictureContentType = dto.ProfilePictureContentType
            };

            // Hash password and set security stamp
            var hasher = new PasswordHasher<Repositories.Entities.Customer>();
            customer.PasswordHash = hasher.HashPassword(customer, dto.Password);
            customer.SecurityStamp = Guid.NewGuid().ToString();

            await admin.AddCustomerAsync(customer);
            await admin.SaveChangesAsync();
            return Results.Created($"/api/customers/{customer.Id}", customer);
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }

    static async Task<IResult> UpdateCustomer(string id, [FromBody] NorthWind.Sales.Backend.Repositories.Entities.Customer customer, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesAdminDataContext admin)
    {
        if (id != customer.Id) return Results.BadRequest();
        admin.UpdateCustomerAsync(customer);
        await admin.SaveChangesAsync();
        return Results.NoContent();
    }

    static async Task<IResult> DeleteCustomer(string id, NorthWind.Sales.Backend.Repositories.Interfaces.INorthWindSalesAdminDataContext admin)
    {
        try
        {
            // Validar que el cliente no tenga órdenes asociadas
            if (await admin.HasOrdersAsync(id))
            {
                return Results.BadRequest(new 
                { 
                    error = $"No se puede eliminar el cliente '{id}' porque tiene órdenes asociadas. " +
                            "Elimine primero todas las órdenes relacionadas."
                });
            }

            await admin.DeleteCustomerAsync(id);
            await admin.SaveChangesAsync();
            return Results.NoContent();
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }
}
