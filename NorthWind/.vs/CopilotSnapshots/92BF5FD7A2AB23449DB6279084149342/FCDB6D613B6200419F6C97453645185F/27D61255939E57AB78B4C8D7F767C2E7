        string Password, string PasswordConfirm, string Cedula,
        string? City, string? Phone, decimal CurrentBalance, IFormFile? ProfilePicture
    );

    static string GenerateCustomerId()
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        var sb = new StringBuilder(5);
        var rnd = new Random();
        for (int i = 0; i < 5; i++) sb.Append(chars[rnd.Next(chars.Length)]);
        return sb.ToString();
    }

    static async Task<string> GenerateUniqueCustomerId(INorthWindSalesQueriesDataContext queries)
    {
        string id;
        int attempts = 0;
        do
        {
            id = GenerateCustomerId();
            var exists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Id == id));
            if (exists == null) return id;
            attempts++;
        } while (attempts < 10);
        throw new InvalidOperationException("Unable to generate unique customer ID after multiple attempts.");
    }

    static async Task<IResult> CreateCustomerJson([FromBody] CreateCustomerDto dto, INorthWindSalesAdminDataContext admin, INorthWindSalesQueriesDataContext queries, HttpContext httpContext)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.FirstName)) return Results.BadRequest(new { error = "FirstName is required." });
            if (string.IsNullOrWhiteSpace(dto.LastName)) return Results.BadRequest(new { error = "LastName is required." });
            if (string.IsNullOrWhiteSpace(dto.Email)) return Results.BadRequest(new { error = "Email is required." });
            if (string.IsNullOrWhiteSpace(dto.Password)) return Results.BadRequest(new { error = "Password is required." });
            if (dto.Password != dto.PasswordConfirm) return Results.BadRequest(new { error = "Passwords do not match." });
            if (dto.Password.Length < 6) return Results.BadRequest(new { error = "Password must be at least 6 characters." });
            if (string.IsNullOrWhiteSpace(dto.Phone)) return Results.BadRequest(new { error = "Phone is required." });
            if (string.IsNullOrWhiteSpace(dto.Cedula)) return Results.BadRequest(new { error = "Cedula is required." });
            if (dto.Cedula.Length != 10) return Results.BadRequest(new { error = "Cedula must be 10 characters long." });

            // Validate cedula uniqueness
            var cedulaExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Cedula == dto.Cedula));
            if (cedulaExists != null) return Results.BadRequest(new { error = "La cédula ya está siendo usada por otro cliente." });

            // Validate email unique across customers and users
            var emailExistsInCustomers = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Email == dto.Email));
            if (emailExistsInCustomers != null) return Results.BadRequest(new { error = "El correo electrónico ya está siendo usado por otro cliente." });

            var userManager = httpContext.RequestServices.GetService(typeof(UserManager<ApplicationUser>)) as UserManager<ApplicationUser>;
            if (userManager == null) return Results.Problem(detail: "UserManager not available", statusCode: 500);
            var emailExistsInUsers = await userManager.FindByEmailAsync(dto.Email);
            if (emailExistsInUsers != null) return Results.BadRequest(new { error = "El correo electrónico ya está siendo usado por un usuario del sistema." });

            var phoneExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Phone == dto.Phone));
            if (phoneExists != null) return Results.BadRequest(new { error = "El número de teléfono ya está siendo usado por otro cliente." });

            // Generate unique ID
            var newId = await GenerateUniqueCustomerId(queries);

            var customer = new Repositories.Entities.Customer
            {
                Id = newId,
                FirstName = dto.FirstName,
                LastName = dto.LastName,
                Email = dto.Email,
                City = dto.City,
                Phone = dto.Phone,
                CurrentBalance = dto.CurrentBalance,
                Cedula = dto.Cedula
            };

            var hasher = new PasswordHasher<Repositories.Entities.Customer>();
            customer.PasswordHash = hasher.HashPassword(customer, dto.Password);
            customer.SecurityStamp = Guid.NewGuid().ToString();

            await admin.AddCustomerAsync(customer);
            await admin.SaveChangesAsync();
            return Results.Created($"/api/customers/{customer.Id}", customer);
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }

    static async Task<IResult> CreateCustomerForm([FromForm] CreateCustomerFormDto dto, INorthWindSalesAdminDataContext admin, INorthWindSalesQueriesDataContext queries, HttpContext httpContext)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Email)) return Results.BadRequest(new { error = "Email is required." });
            if (string.IsNullOrWhiteSpace(dto.Cedula)) return Results.BadRequest(new { error = "Cedula is required." });
            if (dto.Cedula.Length != 10) return Results.BadRequest(new { error = "Cedula must be 10 characters long." });

            var emailExistsInCustomers = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Email == dto.Email));
            if (emailExistsInCustomers != null) return Results.BadRequest(new { error = "El correo electrónico ya está siendo usado por otro cliente." });

            var userManager = httpContext.RequestServices.GetService(typeof(UserManager<ApplicationUser>)) as UserManager<ApplicationUser>;
            if (userManager == null) return Results.Problem(detail: "UserManager not available", statusCode: 500);
            var emailExistsInUsers = await userManager.FindByEmailAsync(dto.Email);
            if (emailExistsInUsers != null) return Results.BadRequest(new { error = "El correo electrónico ya está siendo usado por un usuario del sistema." });

            var phoneExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Phone == dto.Phone));
            if (phoneExists != null) return Results.BadRequest(new { error = "El número de teléfono ya está siendo usado por otro cliente." });

            var cedulaExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Cedula == dto.Cedula));
            if (cedulaExists != null) return Results.BadRequest(new { error = "La cédula ya está siendo usada por otro cliente." });

            var newId = await GenerateUniqueCustomerId(queries);

            var customer = new Repositories.Entities.Customer
            {
                Id = newId,
                FirstName = dto.FirstName,
                LastName = dto.LastName,
                Email = dto.Email,
                City = dto.City,
                Phone = dto.Phone,
                CurrentBalance = dto.CurrentBalance,
                Cedula = dto.Cedula
            };

            if (dto.ProfilePicture != null && dto.ProfilePicture.Length > 0)
            {
                using var ms = new MemoryStream();
                await dto.ProfilePicture.CopyToAsync(ms);
                customer.ProfilePictureData = ms.ToArray();
                customer.ProfilePictureContentType = dto.ProfilePicture.ContentType;
            }

            var hasher = new PasswordHasher<Repositories.Entities.Customer>();
            customer.PasswordHash = hasher.HashPassword(customer, dto.Password);
            customer.SecurityStamp = Guid.NewGuid().ToString();

            await admin.AddCustomerAsync(customer);
            await admin.SaveChangesAsync();
            return Results.Created($"/api/customers/{customer.Id}", customer);
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }

    static async Task<IResult> UploadProfilePicture(string id, IFormFile file, INorthWindSalesAdminDataContext admin, INorthWindSalesQueriesDataContext queries)
    {
        try
        {
            if (file == null || file.Length == 0) return Results.BadRequest(new { error = "No file provided." });
            var customer = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Id == id));
            if (customer == null) return Results.NotFound();

            using var ms = new MemoryStream();
            await file.CopyToAsync(ms);
            customer.ProfilePictureData = ms.ToArray();
            customer.ProfilePictureContentType = file.ContentType;

            admin.UpdateCustomerAsync(customer);
            await admin.SaveChangesAsync();
            return Results.Ok();
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }

    public record UpdateCustomerDto(
        string Id, string FirstName, string LastName, string Email,
        string? City, string? Phone, decimal CurrentBalance,
        string? Password, string? PasswordConfirm, string Cedula
    );

    static async Task<IResult> UpdateCustomer(string id, [FromBody] UpdateCustomerDto dto, INorthWindSalesAdminDataContext admin, INorthWindSalesQueriesDataContext queries, HttpContext httpContext)
    {
        try
        {
            if (id != dto.Id) return Results.BadRequest(new { error = "Id mismatch." });

            var existing = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Id == id));
            if (existing == null) return Results.NotFound();

            if (string.IsNullOrWhiteSpace(dto.Email)) return Results.BadRequest(new { error = "Email is required." });

            // Validación cruzada al actualizar
            var emailExistsInCustomers = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Email == dto.Email && c.Id != id));
            if (emailExistsInCustomers != null) return Results.BadRequest(new { error = "El correo electrónico ya está registrado por otra persona en el sistema." });

            var userManager = httpContext.RequestServices.GetService(typeof(UserManager<ApplicationUser>)) as UserManager<ApplicationUser>;
            if (userManager == null) return Results.Problem(detail: "UserManager not available", statusCode: 500);
            var emailExistsInUsers = await userManager.FindByEmailAsync(dto.Email);
            if (emailExistsInUsers != null) return Results.BadRequest(new { error = "El correo electrónico ya está registrado por otra persona en el sistema." });

            var phoneExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Phone == dto.Phone && c.Id != id));
            if (phoneExists != null) return Results.BadRequest(new { error = "El número de teléfono ya está siendo usado por otra persona del sistema." });

            // Cedula uniqueness on update (exclude current)
            var cedulaExists = await queries.FirstOrDefaultAync(queries.Customers.Where(c => c.Cedula == dto.Cedula && c.Id != id));
            if (cedulaExists != null) return Results.BadRequest(new { error = "La cédula ya está siendo usada por otra persona del sistema." });

            if (!string.IsNullOrEmpty(dto.Password) || !string.IsNullOrEmpty(dto.PasswordConfirm))
            {
                if (dto.Password != dto.PasswordConfirm) return Results.BadRequest(new { error = "Passwords do not match." });
                if (dto.Password != null && dto.Password.Length < 6) return Results.BadRequest(new { error = "Password must be at least 6 characters." });

                var hasher = new PasswordHasher<Repositories.Entities.Customer>();
                existing.PasswordHash = hasher.HashPassword(existing, dto.Password);
                existing.SecurityStamp = Guid.NewGuid().ToString();
            }

            existing.FirstName = dto.FirstName;
            existing.LastName = dto.LastName;
            existing.Email = dto.Email;
            existing.City = dto.City;
            existing.Phone = dto.Phone;
            existing.CurrentBalance = dto.CurrentBalance;
            existing.Cedula = dto.Cedula;

            admin.UpdateCustomerAsync(existing);
            await admin.SaveChangesAsync();
            return Results.NoContent();
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }

    static async Task<IResult> DeleteCustomer(string id, INorthWindSalesAdminDataContext admin)
    {
        try
        {
            if (await admin.HasOrdersAsync(id))
            {
                return Results.BadRequest(new { error = $"No se puede eliminar el cliente '{id}' porque tiene órdenes asociadas. Elimine primero todas las órdenes relacionadas." });
            }

            await admin.DeleteCustomerAsync(id);
            await admin.SaveChangesAsync();
            return Results.NoContent();
        }
        catch (Exception ex)
        {
            return Results.Problem(detail: ex.Message, statusCode: 500);
        }
    }
